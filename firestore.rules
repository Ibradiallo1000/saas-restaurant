rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return userExists()
        && userDoc().data.role in ["super_admin", "admin"];
    }

    function userRestaurantId() {
      return userExists()
        ? userDoc().data.restaurantId
        : null;
    }

    function isRestaurantMember(restaurantId) {
      return userRestaurantId() == restaurantId;
    }

    function isRestaurantStaff(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid));
    }

    function isRestaurantOwnerEmail(restaurantId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerEmail == request.auth.token.email;
    }

    function isRestaurantOwner(restaurantId) {
      return isRestaurantOwnerEmail(restaurantId)
        || (
          isRestaurantStaff(restaurantId)
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "owner"
        );
    }

    function isRestaurantManager(restaurantId) {
      return isSignedIn()
        && (
          (
            userExists()
            && userDoc().data.restaurantId == restaurantId
            && userDoc().data.role in ["manager", "owner"]
          )
          || (
            isRestaurantStaff(restaurantId)
            && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role in ["manager", "owner"]
          )
          || isRestaurantOwnerEmail(restaurantId)
        );
    }

    function canApproveCashSession(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId);
    }

    function canReadRestaurantInventoryItems(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId) || canManageRestaurantMenu(restaurantId);
    }

    function canWriteRestaurantInventoryItems(restaurantId) {
      return isSuperAdmin()
        || (
          isSignedIn()
          && (
            (
              userExists()
              && userDoc().data.restaurantId == restaurantId
              && userDoc().data.role == "manager"
            )
            || (
              isRestaurantStaff(restaurantId)
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "manager"
            )
          )
        );
    }

    function canManageRestaurantMenu(restaurantId) {
      return isSuperAdmin()
        || (
          userExists()
          && userDoc().data.restaurantId == restaurantId
          && userDoc().data.role in ["owner", "manager"]
        );
    }

    function isInventorySaleDecrement(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "stockEstimated",
          "updatedAt"
        ])
        && request.resource.data.stockEstimated is number
        && request.resource.data.stockEstimated <= resource.data.stockEstimated;
    }

    function isInventoryConsumptionStatsUpdate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "avgDailyConsumption",
          "consumptionTotal",
          "consumptionDays",
          "dailyConsumptionDate",
          "dailyConsumptionUsed",
          "updatedAt"
        ])
        && request.resource.data.avgDailyConsumption is number
        && request.resource.data.avgDailyConsumption >= 0
        && request.resource.data.consumptionTotal is number
        && request.resource.data.consumptionTotal >= 0
        && request.resource.data.consumptionDays is number
        && request.resource.data.consumptionDays >= 0
        && request.resource.data.dailyConsumptionDate is string
        && request.resource.data.dailyConsumptionUsed is number
        && request.resource.data.dailyConsumptionUsed >= 0;
    }

    function isInventorySupplyUpdate(restaurantId) {
      return canWriteRestaurantInventoryItems(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "stockEstimated",
          "costPerUnit",
          "updatedAt"
        ])
        && request.resource.data.stockEstimated is number
        && request.resource.data.stockEstimated >= resource.data.stockEstimated
        && request.resource.data.costPerUnit is number
        && request.resource.data.costPerUnit >= 0;
    }

    function isInventoryThresholdUpdate(restaurantId) {
      return canWriteRestaurantInventoryItems(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "minThreshold",
          "updatedAt"
        ])
        && request.resource.data.minThreshold is number
        && request.resource.data.minThreshold >= 0;
    }

    function canReadRestaurantBusinessDocs(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId);
    }

    function canWriteRestaurantBusinessDocs(restaurantId) {
      return isSuperAdmin() || isRestaurantManager(restaurantId);
    }

    function isPaidStatus(status) {
      return status in ["paye", "paid", "validated", "verified"];
    }

    function isValidOrderStatus(status) {
      return status in ["pending", "preparing", "ready", "served", "picked_up", "cancelled"];
    }

    function hasLegacyOrderStatusFields(data) {
      return data.keys().hasAny(["status"]);
    }

    function changesLegacyOrderStatusFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]);
    }

    function hasValidOrderStatusIfPresent() {
      return !request.resource.data.keys().hasAny(["orderStatus"])
        || isValidOrderStatus(request.resource.data.orderStatus);
    }

    function hasValidKitchenStatusIfPresent() {
      return !request.resource.data.keys().hasAny(["kitchenStatus"])
        || isValidOrderStatus(request.resource.data.kitchenStatus);
    }

    function hasCashSessionForVerifiedPayment() {
      return !isPaidStatus(request.resource.data.paymentStatus)
        || request.resource.data.cashSessionId is string;
    }

    function isCriticalOrderDataChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "amount",
        "total",
        "totalAmount",
        "subtotal",
        "deliveryFee",
        "items"
      ]);
    }

    function isKitchenProductionUpdate() {
      return canUseRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && !changesLegacyOrderStatusFields()
        && hasValidOrderStatusIfPresent()
        && hasValidKitchenStatusIfPresent()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "orderStatus",
          "kitchenStatus",
          "statusHistory",
          "items",
          "timestamps",
          "updatedAt"
        ]);
    }

    function isTechnicalPaidOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "printedKitchen",
        "printedClient",
        "paymentIntentStatus",
        "paymentVerificationStatus",
        "paymentVerifiedAt",
        "paymentVerifiedBy",
        "sessionActive",
        "completedAt",
        "updatedAt"
      ]);
    }

    function isRefundMarkerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "refunded",
        "refundTotal",
        "updatedAt"
      ]);
    }

    function canUpdateOrder(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && !changesLegacyOrderStatusFields()
        && hasValidOrderStatusIfPresent()
        && hasValidKitchenStatusIfPresent()
        && (hasCashSessionForVerifiedPayment() || isKitchenProductionUpdate())
        && (!isCriticalOrderDataChange() || isKitchenProductionUpdate())
        && (
          (
            !isPaidStatus(resource.data.paymentStatus)
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentStatus"])
              || !isPaidStatus(resource.data.paymentStatus)
            )
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && isTechnicalPaidOrderUpdate()
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && isKitchenProductionUpdate()
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && canApproveCashSession(restaurantId)
            && isRefundMarkerUpdate()
          )
        );
    }

    function canUpdatePublicTablePaymentRequest() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentRequest", "updatedAt"])
        && (request.resource.data.paymentRequest.status in ["requested", "pending_confirmation"]);
    }

    function canCreatePublicTableSession(restaurantId) {
      return request.resource.data.tableId is string
        && request.resource.data.zoneId is string
        && request.resource.data.status == "active"
        && request.resource.data.closedAt == null
        && request.resource.data.totalAmount == 0
        && request.resource.data.paymentRequest.status == "none"
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId))
        && (
          get(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId)).data.zoneId == request.resource.data.zoneId
          || (
            !get(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId)).data.keys().hasAny(["zoneId"])
            && request.resource.data.zoneId == "main"
          )
        );
    }

    function canTouchPublicTableSession() {
      return resource.data.status == "active"
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActivityAt"]);
    }

    function canClosePublicTableSession() {
      return resource.data.status == "active"
        && request.resource.data.status == "closed"
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "closedAt", "lastActivityAt"]);
    }

    function canUpdatePublicTableSessionPointer(restaurantId, tableId) {
      return request.resource.data.zoneId is string
        && (
          request.resource.data.zoneId == resource.data.zoneId
          || (
            !resource.data.keys().hasAny(["zoneId"])
            && request.resource.data.zoneId == "main"
          )
        )
        && request.resource.data.status == "occupied"
        && request.resource.data.currentSessionId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "currentSessionId",
          "zoneId",
          "updatedAt",
          "lastActivityAt"
        ])
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.status == "active"
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.tableId == tableId
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.zoneId == request.resource.data.zoneId;
    }

    function canUpdatePublicPaymentIntent(restaurantId) {
      return resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == restaurantId
        && resource.data.source in ["client", "qr", "qr_table", "manual"]
        && !isPaidStatus(resource.data.paymentStatus)
        && (
          request.resource.data.paymentStatus == resource.data.paymentStatus
          || (
            resource.data.paymentStatus == "unpaid"
            && request.resource.data.paymentStatus in ["pending_mobile", "pending", "pending_cash"]
          )
          || (
            resource.data.source != "qr_table"
            && resource.data.paymentStatus == "unpaid"
            && request.resource.data.paymentStatus == "pending_verification"
          )
        )
        && request.resource.data.orderStatus == resource.data.orderStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "source",
          "paymentMethod",
          "paymentMethodCode",
          "paymentProvider",
          "paymentType",
          "paymentIntentStatus",
          "paymentStatus",
          "paymentCode",
          "paymentInstruction",
          "needsCashCollection",
          "paymentVerificationStatus",
          "paymentVerificationRequestedAt",
          "updatedAt"
        ])
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentIntentStatus in ["pending", "submitted"];
    }

    function canAppendActiveDineInOrder(restaurantId) {
      return resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == restaurantId
        && resource.data.source in ["qr", "qr_table"]
        && resource.data.orderType == "dine_in"
        && request.resource.data.orderType == resource.data.orderType
        && resource.data.sessionActive == true
        && !isPaidStatus(resource.data.paymentStatus)
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.items is list
        && request.resource.data.items.size() >= resource.data.items.size()
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "subtotal",
          "total",
          "totalAmount",
          "updatedAt"
        ])
        && request.resource.data.sessionActive == true
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.orderStatus == resource.data.orderStatus
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId)).data.status == "active"
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId)).data.tableId == resource.data.tableId;
    }

    function isValidPaymentSource(source) {
      return source in ["pos", "qr_table", "delivery"];
    }

    function isValidPaymentType(type) {
      return type in ["cash", "mobile_money"];
    }

    function isValidPaymentLedgerStatus(status) {
      return status in ["pending", "confirmed", "failed", "refunded", "voided"];
    }

    function isValidPaymentCreateTimestamps(data) {
      return data.createdAt is timestamp
        && (
          data.status == "confirmed"
          ? (data.confirmedAt is timestamp && data.confirmedBy == request.auth.uid)
          : (!data.keys().hasAny(["confirmedAt"]) || data.confirmedAt == null)
        )
        && (
          data.status == "failed"
          ? (data.failedAt is timestamp && data.failedBy == request.auth.uid && data.failureReason is string)
          : (!data.keys().hasAny(["failedAt"]) || data.failedAt == null)
        );
    }

    function isValidPaymentStatusTransition() {
      return resource.data.status == "pending"
        && (
          (
            request.resource.data.status == "confirmed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "confirmedAt", "confirmedBy"])
            && request.resource.data.confirmedAt is timestamp
            && request.resource.data.confirmedBy == request.auth.uid
          )
          || (
            request.resource.data.status == "failed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "failedAt", "failedBy", "failureReason"])
            && request.resource.data.failedAt is timestamp
            && request.resource.data.failedBy == request.auth.uid
            && request.resource.data.failureReason is string
          )
        );
    }

    function hasOpenCashSession(restaurantId, sessionId, cashierId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.status == "open"
        && (
          get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.cashierId == cashierId
          || get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.userId == cashierId
        );
    }

    function isValidPaymentCreate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.orderId is string
        && request.resource.data.sessionId is string
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && isValidPaymentSource(request.resource.data.source)
        && isValidPaymentType(request.resource.data.type)
        && isValidPaymentLedgerStatus(request.resource.data.status)
        && request.resource.data.idempotencyKey is string
        && isValidPaymentCreateTimestamps(request.resource.data)
        && (
          request.resource.data.type == "cash"
          ? request.resource.data.provider == null
          : (request.resource.data.provider == null || request.resource.data.provider is string)
        )
        && hasOpenCashSession(restaurantId, request.resource.data.sessionId, request.resource.data.cashierId);
    }

    function isCashSessionAggregateUpdate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && resource.data.status == "open"
        && request.resource.data.status == "open"
        && (resource.data.cashierId == request.auth.uid || resource.data.userId == request.auth.uid)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "totalCash",
          "totalMobile",
          "totalMobileMoney",
          "totalOrders",
          "totalPayments",
          "totalConfirmed",
          "totalsByProvider",
          "totalsBySource",
          "updatedAt"
        ]);
    }

    function canUseRestaurant(restaurantId) {
      return isSuperAdmin()
        || isRestaurantMember(restaurantId)
        || isRestaurantStaff(restaurantId)
        || isRestaurantOwnerEmail(restaurantId);
    }

    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() > 0;
      allow update: if isSuperAdmin() || isRestaurantOwner(restaurantId);
      allow delete: if isSuperAdmin();

      match /staff/{staffId} {
        allow read: if canUseRestaurant(restaurantId);
        allow write: if isSuperAdmin() || isRestaurantOwner(restaurantId);
      }

      match /categories/{categoryId} {
        allow get, list: if true;
        allow write: if canManageRestaurantMenu(restaurantId);
      }

      match /products/{productId} {
        allow get, list: if true;
        allow write: if canManageRestaurantMenu(restaurantId);
      }

      match /menuItems/{menuItemId} {
        allow get, list: if true;
        allow write: if canManageRestaurantMenu(restaurantId);
      }

      match /inventory/{inventoryId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow write: if canUseRestaurant(restaurantId);
      }

      match /inventoryItems/{itemId} {
        allow get, list: if canReadRestaurantInventoryItems(restaurantId);
        allow create: if canWriteRestaurantInventoryItems(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.unit in ["pièce", "kg", "litre"]
          && request.resource.data.stockEstimated is number
          && request.resource.data.stockEstimated >= 0
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold is number)
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold >= 0)
          && request.resource.data.lastCountedStock is number
          && request.resource.data.lastCountedStock >= 0
          && request.resource.data.avgDailyConsumption is number
          && request.resource.data.avgDailyConsumption >= 0
          && request.resource.data.costPerUnit is number
          && request.resource.data.costPerUnit >= 0
          && request.resource.data.lossRate is number
          && request.resource.data.lossRate >= 0
          && request.resource.data.lossRate <= 1;
        allow update: if (
          canWriteRestaurantInventoryItems(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.unit in ["pièce", "kg", "litre"]
          && request.resource.data.stockEstimated is number
          && request.resource.data.stockEstimated >= 0
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold is number)
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold >= 0)
          && request.resource.data.costPerUnit is number
          && request.resource.data.costPerUnit >= 0
          && request.resource.data.lossRate is number
          && request.resource.data.lossRate >= 0
          && request.resource.data.lossRate <= 1
        ) || isInventorySaleDecrement(restaurantId)
          || isInventorySupplyUpdate(restaurantId)
          || isInventoryThresholdUpdate(restaurantId)
          || isInventoryConsumptionStatsUpdate(restaurantId);
        allow delete: if isSuperAdmin();
      }

      match /inventoryMovements/{movementId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["supply", "adjustment", "sale"]
          && request.resource.data.inventoryItemId is string
          && request.resource.data.quantity is number
          && (
            (
              request.resource.data.type in ["supply", "adjustment"]
              && request.resource.data.quantity > 0
              && request.resource.data.createdBy == request.auth.uid
            )
            || (
              request.resource.data.type == "sale"
              && request.resource.data.quantity < 0
              && request.resource.data.source == "system"
            )
          )
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /suppliers/{supplierId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantBusinessDocs(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if canWriteRestaurantBusinessDocs(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0;
        allow delete: if isSuperAdmin();
      }

      match /expenses/{expenseId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["supply", "salary", "other"]
          && request.resource.data.paymentStatus in ["paid", "partial", "unpaid"]
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidAmount is number
          && request.resource.data.paidAmount >= 0
          && request.resource.data.paidAmount <= request.resource.data.amount
          && request.resource.data.validated == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if isRestaurantOwner(restaurantId)
          && request.resource.data.validated is bool;
        allow delete: if false;
      }

      match /expenseLogs/{expenseId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantBusinessDocs(restaurantId)
          && request.resource.data.expenseId == expenseId
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /supplierPayments/{paymentId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.supplierId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /inventoryAlerts/{alertId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.type in ["low_stock", "incoherent_stock", "missing_cost"]
          && request.resource.data.itemId is string
          && request.resource.data.message is string
          && request.resource.data.severity in ["low", "medium", "high"]
          && request.resource.data.resolved is bool
          && request.resource.data.createdAt is timestamp;
        allow update: if canUseRestaurant(restaurantId)
          && request.resource.data.resolved is bool;
        allow delete: if isSuperAdmin();
      }

      match /inventoryLogs/{logId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.paymentId == logId
          && request.resource.data.decrementCount is number
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /customers/{customerId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow write: if canUseRestaurant(restaurantId);
      }

      match /cashierSessions/{sessionId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create, update: if canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId;
        allow delete: if isSuperAdmin();
      }

      match /cashSessions/{sessionId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if (
          canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && (request.resource.data.cashierId == request.auth.uid || request.resource.data.userId == request.auth.uid)
          && request.resource.data.status == "open"
        ) || (
          canApproveCashSession(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId is string
          && request.resource.data.status == "open"
          && request.resource.data.approvedBy == request.auth.uid
        );
        allow update: if isCashSessionAggregateUpdate(restaurantId)
          || (
            resource.data.status != "validated"
            && request.resource.data.restaurantId == restaurantId
            && request.resource.data.status in ["open", "closed", "pending_validation", "validated"]
            && (
              canApproveCashSession(restaurantId)
              || (
                canUseRestaurant(restaurantId)
                && (resource.data.cashierId == request.auth.uid || resource.data.userId == request.auth.uid)
                && resource.data.status == "open"
                && request.resource.data.status in ["closed", "pending_validation"]
                && request.resource.data.validatedByManager == false
              )
            )
          );
        allow delete: if isSuperAdmin();
      }

      match /payments/{paymentId} {
        allow get, list: if canApproveCashSession(restaurantId) || canUseRestaurant(restaurantId);
        allow create: if isValidPaymentCreate(restaurantId);
        allow update: if canUseRestaurant(restaurantId)
          && resource.data.status != "confirmed"
          && isValidPaymentStatusTransition()
          && hasOpenCashSession(restaurantId, resource.data.sessionId, resource.data.cashierId);
        allow delete: if false;
      }

      match /treasuryAccounts/{accountId} {
        allow get, list: if canApproveCashSession(restaurantId) || canUseRestaurant(restaurantId);
        allow create: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && accountId in ["cash", "mobile_money", "bank"]
          && request.resource.data.id == accountId
          && request.resource.data.name is string
          && request.resource.data.kind in ["cash", "mobile_money", "bank"]
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.currency is string
          && request.resource.data.active is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && request.resource.data.id == resource.data.id
          && request.resource.data.name is string
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.currency is string
          && request.resource.data.active is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /cashMovements/{movementId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["deposit", "expense", "transfer"]
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.source in ["session", "manual", "expense", "payment", "transfer"]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && (
            request.resource.data.type != "deposit"
            || (
              request.resource.data.source == "session"
              && request.resource.data.sessionId is string
              && (
                movementId == "session-" + request.resource.data.sessionId
                || movementId == "session-" + request.resource.data.sessionId + "-cash"
                || movementId == "session-" + request.resource.data.sessionId + "-mobile"
              )
              && !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/cashMovements/$(movementId))
            )
          );
        allow update, delete: if false;
      }

      match /cashSessionRequests/{requestId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId == request.auth.uid
          && request.resource.data.status == "pending";
        allow update: if canApproveCashSession(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId == resource.data.cashierId
          && request.resource.data.status in ["pending", "approved", "rejected"];
        allow delete: if isSuperAdmin();
      }

      match /tables/{tableId} {
        allow get, list: if true;
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.zoneId is string
          && request.resource.data.status == "free"
          && request.resource.data.currentSessionId == null;
        allow update: if canUseRestaurant(restaurantId)
          || canUpdatePublicTableSessionPointer(restaurantId, tableId);
        allow delete: if isSuperAdmin();
      }

      match /tableSessions/{sessionId} {
        allow get: if canUseRestaurant(restaurantId) || resource.data.status == "active";
        allow list: if canUseRestaurant(restaurantId);
        allow create: if (
          canUseRestaurant(restaurantId)
          && request.resource.data.tableId is string
          && request.resource.data.zoneId is string
          && request.resource.data.status == "active"
          && request.resource.data.closedAt == null
        ) || canCreatePublicTableSession(restaurantId);
        allow update: if canUseRestaurant(restaurantId)
          || canUpdatePublicTablePaymentRequest()
          || canTouchPublicTableSession()
          || canClosePublicTableSession();
        allow delete: if isSuperAdmin();
      }

      match /visits/{visitId} {
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.tableId is string
          && request.resource.data.sessionId is string;
        allow get, list: if canUseRestaurant(restaurantId);
        allow update, delete: if isSuperAdmin();
      }

      match /images/{imageId} {
        allow get, list: if canManageRestaurantMenu(restaurantId);
        allow create: if canManageRestaurantMenu(restaurantId)
          && request.resource.data.url is string
          && request.resource.data.publicId is string;
        allow update, delete: if canManageRestaurantMenu(restaurantId);
      }

      match /orders/{orderId} {
        allow create: if
          request.resource.data.restaurantId == restaurantId
          && request.resource.data.items is list
          && request.resource.data.total is number
          && !hasLegacyOrderStatusFields(request.resource.data)
          && request.resource.data.orderStatus is string
          && isValidOrderStatus(request.resource.data.orderStatus)
          && hasValidKitchenStatusIfPresent()
          && hasCashSessionForVerifiedPayment()
          && (
            (
              request.resource.data.source in ["client", "qr", "qr_table", "manual"]
              && (
                (
                  // Dine-in orders require a table session
                  request.resource.data.orderType == "dine_in"
                  && request.resource.data.sessionId is string
                  && request.resource.data.tableId is string
                  && request.resource.data.zoneId is string
                  && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId))
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.status == "active"
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.tableId == request.resource.data.tableId
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.zoneId == request.resource.data.zoneId
                )
                ||
                (
                  // Takeaway and delivery don't require table sessions
                  request.resource.data.orderType in ["takeaway", "pickup", "delivery"]
                  && request.resource.data.sessionId == null
                  && request.resource.data.tableId == null
                )
              )
            )
            || (
              canUseRestaurant(restaurantId)
              && request.resource.data.source == "pos"
              && (
                !(request.resource.data.tableId is string)
                || (
                  request.resource.data.sessionId is string
                  && request.resource.data.zoneId is string
                  && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId))
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.status == "active"
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.tableId == request.resource.data.tableId
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.zoneId == request.resource.data.zoneId
                )
              )
            )
          );

        allow get: if canUseRestaurant(restaurantId)
          || (
            resource.data.restaurantId == restaurantId
            && resource.data.source in ["client", "qr", "qr_table", "manual"]
            && (resource.data.sessionId is string || resource.data.tableSessionId is string)
          );

        allow list: if canUseRestaurant(restaurantId)
          || (
            resource.data.restaurantId == restaurantId
            && resource.data.source in ["client", "qr", "qr_table", "manual"]
            && (resource.data.sessionId is string || resource.data.tableSessionId is string)
          );
        allow update: if canUpdateOrder(restaurantId)
          || canUpdatePublicPaymentIntent(restaurantId)
          || canAppendActiveDineInOrder(restaurantId);
        allow delete: if false;

        match /auditLogs/{logId} {
          allow get, list: if canApproveCashSession(restaurantId);
          allow create: if canUseRestaurant(restaurantId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.orderId == orderId
            && request.resource.data.action is string
            && request.resource.data.before is map
            && request.resource.data.after is map
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }

        match /costSnapshot/{snapshotId} {
          allow get, list: if canReadRestaurantInventoryItems(restaurantId);
          allow create: if canUseRestaurant(restaurantId)
            && request.resource.data.paymentId == snapshotId
            && request.resource.data.totalCost is number
            && request.resource.data.totalCost >= 0
            && request.resource.data.totalSales is number
            && request.resource.data.margin is number
            && request.resource.data.createdDate is string
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }

        match /orderItems/{itemId} {
          allow get, list: if canUseRestaurant(restaurantId);
          allow create, update: if canUseRestaurant(restaurantId);
          allow delete: if isSuperAdmin();
        }
      }

      match /auditLogs/{logId} {
        allow get, list: if canApproveCashSession(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.orderId is string
          && request.resource.data.action is string
          && request.resource.data.before is map
          && request.resource.data.after is map
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /refunds/{refundId} {
        allow get, list: if canApproveCashSession(restaurantId);
        allow create: if canApproveCashSession(restaurantId)
          && request.resource.data.orderId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.reason is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if request.auth.uid == userId
        || isSuperAdmin()
        || (
          request.resource.data.restaurantId is string
          && canUseRestaurant(request.resource.data.restaurantId)
        );

      allow update: if request.auth.uid == userId
        || isSuperAdmin()
        || (
          resource.data.restaurantId is string
          && canUseRestaurant(resource.data.restaurantId)
        );

      allow delete: if isSuperAdmin();
    }

    match /restaurantSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isSuperAdmin()
        || canUseRestaurant(resource.data.restaurantId);
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /invitations/{id} {
      allow create: if isSuperAdmin();
      allow get: if true;
      allow list: if false;
      allow update: if true;
    }

    match /contactRequests/{id} {
      allow create: if true;
      allow get, list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /plans/{planId} {
      allow read, write: if isSuperAdmin();
    }

    match /platformSettings/{settingsId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.primaryColor is string
        && request.resource.data.secondaryColor is string
        && request.resource.data.supportEmail is string
        && request.resource.data.supportPhone is string
        && request.resource.data.supportWhatsapp is string
        && request.resource.data.logoUrl is string
        && request.resource.data.faviconUrl is string
        && request.resource.data.maintenanceMode is bool;
      allow delete: if isSuperAdmin();
    }

    match /platformMedia/{mediaId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.url is string
        && request.resource.data.publicId is string
        && request.resource.data.type is string;
      allow update: if isSuperAdmin()
        && request.resource.data.url is string
        && request.resource.data.publicId is string
        && request.resource.data.type is string;
      allow delete: if isSuperAdmin();
    }

    match /platformCountries/{countryId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.currency is string
        && request.resource.data.dialCode is string
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp;
      allow update: if isSuperAdmin()
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.currency is string
        && request.resource.data.dialCode is string
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin();
    }

    match /platformPaymentMethods/{methodId} {
      allow get, list: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.code is string
        && request.resource.data.logoUrl is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.isActive is bool;
      allow update: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.code is string
        && request.resource.data.logoUrl is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin();
    }

    match /platformPaymentVariants/{variantId} {
      allow get, list: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.methodCode is string
        && request.resource.data.countryCode is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.ussdTemplate is string
        && request.resource.data.requiresMerchant is bool
        && request.resource.data.requiresPhone is bool
        && request.resource.data.isActive is bool;
      allow update: if isSuperAdmin()
        && request.resource.data.methodCode is string
        && request.resource.data.countryCode is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.ussdTemplate is string
        && request.resource.data.requiresMerchant is bool
        && request.resource.data.requiresPhone is bool
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin();
    }

    match /restaurantPaymentConfigs/{configId} {
      allow get, list: if true;
      allow create: if canUseRestaurant(request.resource.data.restaurantId)
        && request.resource.data.restaurantId is string
        && request.resource.data.methodCode is string
        && request.resource.data.merchantNumber is string
        && request.resource.data.isActive is bool;
      allow update: if canUseRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.methodCode is string
        && request.resource.data.merchantNumber is string
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin()
        || canUseRestaurant(resource.data.restaurantId);
    }

    match /platform/{docId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
