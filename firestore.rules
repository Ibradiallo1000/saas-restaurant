rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function userExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return userExists()
        && userDoc().data.role in ["super_admin", "admin"];
    }

    function canReadPlatformMenuLibrary() {
      return isSuperAdmin()
        || (
          userExists()
          && userDoc().data.role in ["owner", "manager"]
        );
    }

    function userRestaurantId() {
      return userExists()
        ? userDoc().data.restaurantId
        : null;
    }

    function isRestaurantMember(restaurantId) {
      return userRestaurantId() == restaurantId;
    }

    function isRestaurantStaff(restaurantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid));
    }

    function isRestaurantOwnerEmail(restaurantId) {
      return isSignedIn()
        && "ownerEmail" in get(/databases/$(database)/documents/restaurants/$(restaurantId)).data
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerEmail == request.auth.token.email;
    }

    function isRestaurantOwner(restaurantId) {
      return isRestaurantOwnerEmail(restaurantId)
        || (
          isRestaurantStaff(restaurantId)
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "owner"
        );
    }

    function isRestaurantManager(restaurantId) {
      return isSignedIn()
        && (
          (
            userExists()
            && userDoc().data.restaurantId == restaurantId
            && userDoc().data.role in ["manager", "owner"]
          )
          || (
            isRestaurantStaff(restaurantId)
            && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role in ["manager", "owner"]
          )
          || isRestaurantOwnerEmail(restaurantId)
        );
    }

    function canApproveCashSession(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId);
    }

    function canReadRestaurantInventoryItems(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId) || canManageRestaurantMenu(restaurantId);
    }

    function canReadStockArticleReferential(restaurantId) {
      return canReadRestaurantInventoryItems(restaurantId)
        || (
          userExists()
          && userDoc().data.restaurantId == restaurantId
          && userDoc().data.role == "kitchen"
        )
        || (
          isRestaurantStaff(restaurantId)
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "kitchen"
        );
    }

    function canWriteRestaurantInventoryItems(restaurantId) {
      return isSuperAdmin()
        || (
          isSignedIn()
          && (
            (
              userExists()
              && userDoc().data.restaurantId == restaurantId
              && userDoc().data.role == "manager"
            )
            || (
              isRestaurantStaff(restaurantId)
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "manager"
            )
          )
        );
    }

    function canManageRestaurantMenu(restaurantId) {
      return isSuperAdmin()
        || (
          userExists()
          && userDoc().data.restaurantId == restaurantId
          && userDoc().data.role in ["owner", "manager"]
        );
    }

    function isRestaurantKitchen(restaurantId) {
      return isSignedIn()
        && (
          (
            userExists()
            && userDoc().data.restaurantId == restaurantId
            && userDoc().data.role == "kitchen"
          )
          || (
            isRestaurantStaff(restaurantId)
            && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "kitchen"
          )
        );
    }

    function hasValidOperationalAvailability(product) {
      return !("operationalAvailability" in product)
        || (
          product.operationalAvailability is map
          && product.operationalAvailability.keys().hasOnly([
            "state",
            "reason",
            "updatedAt",
            "updatedBy",
            "scope",
            "serviceId"
          ])
          && product.operationalAvailability.state in ["AVAILABLE", "SOLD_OUT", "PAUSED"]
          && (!("reason" in product.operationalAvailability)
            || product.operationalAvailability.reason == null
            || product.operationalAvailability.reason is string)
          && product.operationalAvailability.updatedAt is timestamp
          && product.operationalAvailability.updatedBy is string
          && (!("scope" in product.operationalAvailability)
            || product.operationalAvailability.scope in ["MANUAL", "CURRENT_SERVICE"])
          && (!("serviceId" in product.operationalAvailability)
            || product.operationalAvailability.serviceId == null
            || product.operationalAvailability.serviceId is string)
        );
    }

    function hasValidPortionControl(product) {
      return !("portionControl" in product)
        || (
          product.portionControl is map
          && product.portionControl.keys().hasOnly(["enabled", "available", "updatedAt", "updatedBy"])
          && product.portionControl.enabled is bool
          && product.portionControl.available is int
          && product.portionControl.available >= 0
          && product.portionControl.updatedAt is timestamp
          && product.portionControl.updatedBy is string
        );
    }

    function isResolvedKitchenProduct(restaurantId, product) {
      return ("preparationMode" in product && product.preparationMode == "kitchen")
        || (
          !("preparationMode" in product)
          && product.categoryId is string
          && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/categories/$(product.categoryId))
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/categories/$(product.categoryId)).data.preparationMode == "kitchen"
        );
    }

    function isKitchenOperationalAvailabilityUpdate(restaurantId) {
      return isRestaurantKitchen(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["operationalAvailability"])
        && hasValidOperationalAvailability(request.resource.data)
        && request.resource.data.operationalAvailability.updatedAt == request.time
        && request.resource.data.operationalAvailability.updatedBy == request.auth.uid
        && isResolvedKitchenProduct(restaurantId, resource.data);
    }

    function hasValidOperationalAvailabilityAudit() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["operationalAvailability"])
        || (
          request.resource.data.operationalAvailability.updatedAt == request.time
          && request.resource.data.operationalAvailability.updatedBy == request.auth.uid
        );
    }

    function isInventorySaleDecrement(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "stockEstimated",
          "updatedAt"
        ])
        && request.resource.data.stockEstimated is number
        && request.resource.data.stockEstimated <= resource.data.stockEstimated;
    }

    function isInventoryConsumptionStatsUpdate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "avgDailyConsumption",
          "consumptionTotal",
          "consumptionDays",
          "dailyConsumptionDate",
          "dailyConsumptionUsed",
          "updatedAt"
        ])
        && request.resource.data.avgDailyConsumption is number
        && request.resource.data.avgDailyConsumption >= 0
        && request.resource.data.consumptionTotal is number
        && request.resource.data.consumptionTotal >= 0
        && request.resource.data.consumptionDays is number
        && request.resource.data.consumptionDays >= 0
        && request.resource.data.dailyConsumptionDate is string
        && request.resource.data.dailyConsumptionUsed is number
        && request.resource.data.dailyConsumptionUsed >= 0;
    }

    function isInventorySupplyUpdate(restaurantId) {
      return canWriteRestaurantInventoryItems(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "stockEstimated",
          "costPerUnit",
          "updatedAt"
        ])
        && request.resource.data.stockEstimated is number
        && request.resource.data.stockEstimated >= resource.data.stockEstimated
        && request.resource.data.costPerUnit is number
        && request.resource.data.costPerUnit >= 0;
    }

    function isInventoryThresholdUpdate(restaurantId) {
      return canWriteRestaurantInventoryItems(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "minThreshold",
          "updatedAt"
        ])
        && request.resource.data.minThreshold is number
        && request.resource.data.minThreshold >= 0;
    }

    function canReadRestaurantBusinessDocs(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId) || isRestaurantManager(restaurantId);
    }

    function hasStockServiceRole(restaurantId) {
      return isSuperAdmin()
        || (
          userExists()
          && userDoc().data.restaurantId == restaurantId
          && userDoc().data.role in ["owner", "manager", "cashier", "kitchen", "server"]
        )
        || (
          isRestaurantStaff(restaurantId)
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.active != false
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role in ["owner", "manager", "cashier", "kitchen", "server"]
        )
        || isRestaurantOwnerEmail(restaurantId);
    }

    function isAutomaticServingBalanceUpdate(restaurantId) {
      let operation = getAfter(
        /databases/$(database)/documents/restaurants/$(restaurantId)/stockOperationsV2/$(request.resource.data.lastOperationId)
      );
      return hasStockServiceRole(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.articleId == resource.data.articleId
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity < resource.data.quantity
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.lastOperationId is string
        && operation.data.type == "AUTOMATIC_DEDUCTION"
        && operation.data.restaurantId == restaurantId
        && operation.data.articleId == resource.data.articleId
        && operation.data.quantityBefore == resource.data.quantity
        && operation.data.quantityAfter == request.resource.data.quantity
        && operation.data.variation == request.resource.data.quantity - resource.data.quantity
        && operation.data.createdBy == request.auth.uid;
    }

    function isLinkedStockBalanceUpdate(restaurantId) {
      let operation = getAfter(
        /databases/$(database)/documents/restaurants/$(restaurantId)/stockOperationsV2/$(request.resource.data.lastOperationId)
      );
      return canReadRestaurantBusinessDocs(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.articleId == resource.data.articleId
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.lastOperationId is string
        && operation.data.restaurantId == restaurantId
        && operation.data.articleId == resource.data.articleId
        && operation.data.quantityBefore == resource.data.quantity
        && operation.data.quantityAfter == request.resource.data.quantity
        && operation.data.variation == request.resource.data.quantity - resource.data.quantity
        && operation.data.createdBy == request.auth.uid;
    }

    function isAutomaticServingOperationCreate(restaurantId) {
      let progress = getAfter(
        /databases/$(database)/documents/restaurants/$(restaurantId)/stockServingProgressV2/$(request.resource.data.orderId + "--" + request.resource.data.orderItemId + "--" + request.resource.data.articleId)
      );
      let orderItem = getAfter(
        /databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)/orderItems/$(request.resource.data.orderItemId)
      );
      let association = get(
        /databases/$(database)/documents/restaurants/$(restaurantId)/stockAutomaticAssociationsV2/$(request.resource.data.associationId)
      );
      let article = get(
        /databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)
      );
      return hasStockServiceRole(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.type == "AUTOMATIC_DEDUCTION"
        && request.resource.data.orderId is string
        && request.resource.data.orderItemId is string
        && request.resource.data.productId is string
        && request.resource.data.articleId is string
        && request.resource.data.associationId is string
        && request.resource.data.quantityBefore is number
        && request.resource.data.quantityAfter is number
        && request.resource.data.variation < 0
        && request.resource.data.quantityAfter
          == request.resource.data.quantityBefore + request.resource.data.variation
        && request.resource.data.servedQuantityBefore is number
        && request.resource.data.servedQuantityAfter is number
        && request.resource.data.servedQuantityAfter > request.resource.data.servedQuantityBefore
        && request.resource.data.quantityPerSale is number
        && request.resource.data.quantityPerSale > 0
        && -request.resource.data.variation
          == (request.resource.data.servedQuantityAfter - request.resource.data.servedQuantityBefore)
            * request.resource.data.quantityPerSale
        && request.resource.data.createdBy == request.auth.uid
        && association.data.restaurantId == restaurantId
        && association.data.productId == request.resource.data.productId
        && association.data.articleId == request.resource.data.articleId
        && association.data.quantity == request.resource.data.quantityPerSale
        && association.data.status == "active"
        && article.data.status == "active"
        && article.data.trackingMode == "AUTOMATIC_SIMPLE"
        && orderItem.data.productId == request.resource.data.productId
        && orderItem.data.servedQuantity == request.resource.data.servedQuantityAfter
        && orderItem.data.servedQuantity <= orderItem.data.quantity
        && progress.data.lastOperationId == request.resource.data.idempotencyKey
            && progress.data.servedQuantity == request.resource.data.servedQuantityAfter;
    }

    function isServedOrderItemUpdate(restaurantId, orderId, orderItemId) {
      return hasStockServiceRole(restaurantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "servedQuantity",
          "servedAt",
          "servedBy"
        ])
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.servedQuantity is number
        && request.resource.data.servedQuantity >= (
          resource.data.servedQuantity is number ? resource.data.servedQuantity : 0
        )
        && request.resource.data.servedQuantity <= resource.data.quantity
        && request.resource.data.servedBy == request.auth.uid
        && (
          request.resource.data.servedQuantity < resource.data.quantity
          || request.resource.data.status == "served"
        );
    }

    function canWriteRestaurantBusinessDocs(restaurantId) {
      return isSuperAdmin() || isRestaurantManager(restaurantId);
    }

    function canWriteRestaurantExpenseDocs(restaurantId) {
      return isSuperAdmin()
        || (
          isSignedIn()
          && (
            (
              userExists()
              && userDoc().data.restaurantId == restaurantId
              && userDoc().data.role == "manager"
            )
            || (
              isRestaurantStaff(restaurantId)
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.role == "manager"
            )
          )
        );
    }

    function canReadRestaurantReviewDocs(restaurantId) {
      return isSuperAdmin() || isRestaurantOwner(restaurantId);
    }

    function reviewAccessExists(restaurantId, orderId) {
      return orderId is string
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/reviewAccess/$(orderId));
    }

    function reviewAccessDoc(restaurantId, orderId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/reviewAccess/$(orderId));
    }

    function isPublicReviewOrderSource(source) {
      return source is string
        && source in ["client", "qr", "qr_table", "public_takeaway", "public_delivery"];
    }

    function publicReviewOrderExists(restaurantId, orderId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId));
    }

    function publicReviewOrder(restaurantId, orderId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId));
    }

    // ─── Helpers sûrs pour champs optionnels ────────────────────────────

    // Retourne true si le champ existe dans le document (get() result).
    function docHas(data, field) {
      return data.keys().hasAny([field]);
    }

    // Vérifie si un champ optionnel est un statut final valide.
    // Protégé : ne lit le champ que s'il existe.
    function optionalFinalOrderStatus(order, fieldName) {
      return docHas(order, fieldName)
        && order[fieldName] is string
        && order[fieldName] in [
          "served", "picked_up", "completed", "delivered",
          "livree", "livré", "recuperee", "récupérée", "terminee", "terminée",
          "servie", "payee", "pretes", "servies"
        ];
    }

    // Vérifie si un champ optionnel est un statut bloqué (annulation).
    // Protégé : ne lit le champ que s'il existe.
    function optionalIsBlockedStatus(order, fieldName) {
      return docHas(order, fieldName)
        && order[fieldName] is string
        && order[fieldName] in [
          "cancelled", "canceled", "annulee", "annulée",
          "refused", "rejected", "failed"
        ];
    }

    // Vérifie si le statut paymentStatus est un paiement confirmé.
    // Protégé : retourne false si le champ n'existe pas.
    function isConfirmedPayment(order) {
      return docHas(order, "paymentStatus")
        && order.paymentStatus is string
        && order.paymentStatus in [
          "paid", "paye", "validated", "verified"
        ];
    }

    // Vérifie si le paiement est en échec.
    function optionalIsFailedPayment(order, fieldName) {
      return docHas(order, fieldName)
        && order[fieldName] is string
        && order[fieldName] in [
          "failed", "rejected", "cancelled", "canceled"
        ];
    }

    // Timestamp final dans order.timestamps — protégé niveau 2.
    function hasFinalTimestampInMap(order, mapField, key) {
      return docHas(order, mapField)
        && order[mapField] is map
        && order[mapField].keys().hasAny([key])
        && order[mapField][key] is timestamp;
    }

    // Timestamp final legacy (champ racine) — protégé.
    function hasLegacyFinalTimestamp(order, key) {
      return docHas(order, key)
        && order[key] is timestamp;
    }

    function isReviewEligibleOrder(order) {
      return order.restaurantId == request.resource.data.restaurantId
        && isPublicReviewOrderSource(order.source)
        && !optionalIsBlockedStatus(order, "status")
        && !optionalIsBlockedStatus(order, "orderStatus")
        && !optionalIsBlockedStatus(order, "kitchenStatus")
        && !optionalIsFailedPayment(order, "paymentStatus")
        && !optionalIsFailedPayment(order, "paymentIntentStatus")
        && !optionalIsFailedPayment(order, "paymentVerificationStatus")
        && isConfirmedPayment(order)
        && isServedByOrderType(order);
    }

    // Détermine si la commande est terminée selon son orderType.
    // Chaque parcours a ses propres critères, aucun croisement.
    function isServedByOrderType(order) {
      return (!docHas(order, "orderType") || !(order.orderType is string))
        // Anciennes commandes sans orderType : fallback sur les timestamps canoniques
        ? reviewOrderHasFinalTimestamp(order)
        : (order.orderType == "dine_in")
          ? reviewOrderHasFinalTimestamp(order)
            || optionalFinalOrderStatus(order, "kitchenStatus")
            || optionalFinalOrderStatus(order, "orderStatus")
          : (order.orderType in ["takeaway", "pickup"])
            ? reviewOrderHasFinalTimestamp(order)
              || optionalFinalOrderStatus(order, "pickupStatus")
              || optionalFinalOrderStatus(order, "orderStatus")
              || optionalFinalOrderStatus(order, "kitchenStatus")
            : (order.orderType == "delivery")
              ? reviewOrderHasFinalTimestamp(order)
                || optionalFinalOrderStatus(order, "deliveryStatus")
                || optionalFinalOrderStatus(order, "orderStatus")
              // orderType inconnu : ne pas autoriser
              : false;
    }

    function reviewOrderHasFinalTimestamp(order) {
      return hasFinalTimestampInMap(order, "timestamps", "servedAt")
        || hasFinalTimestampInMap(order, "timestamps", "pickedUpAt")
        || hasFinalTimestampInMap(order, "timestamps", "deliveredAt")
        || hasFinalTimestampInMap(order, "timestamps", "completedAt")
        || hasLegacyFinalTimestamp(order, "servedAt")
        || hasLegacyFinalTimestamp(order, "pickedUpAt")
        || hasLegacyFinalTimestamp(order, "deliveredAt")
        || hasLegacyFinalTimestamp(order, "completedAt");
    }

    function isFinalReviewOrderStatus(status) {
      return status is string
        && status in ["served", "picked_up", "completed", "delivered", "livree", "livré", "recuperee", "récupérée", "terminee", "terminée", "servie", "payee", "pretes", "servies"];
    }

    function isBlockedReviewOrderStatus(status) {
      return status is string
        && status in ["cancelled", "canceled", "annulee", "annulée", "refused", "rejected", "failed"];
    }

    function isFailedReviewPaymentStatus(status) {
      return status is string
        && status in ["failed", "rejected", "cancelled", "canceled"];
    }

    function isValidReviewAccessCreate(restaurantId, orderId) {
      return orderId is string
        && request.resource.data.keys().hasOnly(["restaurantId", "orderId", "reviewToken", "createdAt", "expiresAt", "version"])
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.orderId == orderId
        && request.resource.data.reviewToken is string
        && request.resource.data.reviewToken.size() >= 36
        && request.resource.data.reviewToken.size() <= 128
        && request.resource.data.version == 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt == null
        && !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.restaurantId == restaurantId
        && isPublicReviewOrderSource(getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.source);
    }

    function isValidReviewPayload(restaurantId, reviewId) {
      return request.resource.data.keys().hasOnly([
          "restaurantId",
          "orderId",
          "orderType",
          "rating",
          "wouldRecommend",
          "comment",
          "customerDisplayName",
          "customerId",
          "customerName",
          "author",
          "source",
          "status",
          "reviewToken",
          "orderCompletedAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.orderId == reviewId
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.wouldRecommend is bool
        && (request.resource.data.comment == null || (request.resource.data.comment is string && request.resource.data.comment.size() <= 600))
        && request.resource.data.source in ["order_tracking", "qr_table", "pickup_delivery_link"]
        && request.resource.data.status == "published"
        && request.resource.data.reviewToken is string
        && request.resource.data.reviewToken.size() >= 36
        && request.resource.data.reviewToken.size() <= 128
        && request.resource.data.orderCompletedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function canCreateRestaurantReview(restaurantId, reviewId) {
      return !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/reviews/$(reviewId))
        && isValidReviewPayload(restaurantId, reviewId)
        && publicReviewOrderExists(restaurantId, reviewId)
        && publicReviewOrder(restaurantId, reviewId).data.restaurantId == restaurantId
        && isReviewEligibleOrder(publicReviewOrder(restaurantId, reviewId).data)
        && reviewAccessExists(restaurantId, reviewId)
        && reviewAccessDoc(restaurantId, reviewId).data.restaurantId == restaurantId
        && reviewAccessDoc(restaurantId, reviewId).data.orderId == reviewId
        && reviewAccessDoc(restaurantId, reviewId).data.reviewToken == request.resource.data.reviewToken
        && reviewAccessDoc(restaurantId, reviewId).data.version == 1;
    }

    function reviewOrderItem(restaurantId, orderId) {
      return publicReviewOrder(restaurantId, orderId).data.items[request.resource.data.orderItemIndex];
    }

    function isValidDishReviewPayload(restaurantId, reviewId) {
      return request.resource.data.keys().hasOnly([
          "restaurantId",
          "orderId",
          "orderType",
          "orderItemId",
          "orderItemIndex",
          "productId",
          "productName",
          "productImageUrl",
          "quantity",
          "rating",
          "comment",
          "customerDisplayName",
          "customerId",
          "customerName",
          "source",
          "status",
          "reviewToken",
          "orderCompletedAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.orderItemId is string
        && request.resource.data.orderItemId.size() > 0
        && reviewId == request.resource.data.orderId + "_" + request.resource.data.orderItemId
        && request.resource.data.orderItemIndex is int
        && request.resource.data.orderItemIndex >= 0
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && (request.resource.data.productImageUrl == null || request.resource.data.productImageUrl is string)
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 1
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && (request.resource.data.comment == null || (request.resource.data.comment is string && request.resource.data.comment.size() <= 400))
        && request.resource.data.source in ["order_tracking", "qr_table", "pickup_delivery_link"]
        && request.resource.data.status == "published"
        && request.resource.data.reviewToken is string
        && request.resource.data.reviewToken.size() >= 36
        && request.resource.data.reviewToken.size() <= 128
        && request.resource.data.orderCompletedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function dishReviewOrderItemMatches(restaurantId, orderId) {
      return publicReviewOrder(restaurantId, orderId).data.items is list
        && request.resource.data.orderItemIndex < publicReviewOrder(restaurantId, orderId).data.items.size()
        && reviewOrderItem(restaurantId, orderId).id == request.resource.data.orderItemId
        && reviewOrderItem(restaurantId, orderId).productId == request.resource.data.productId
        && reviewOrderItem(restaurantId, orderId).name == request.resource.data.productName
        && reviewOrderItem(restaurantId, orderId).quantity == request.resource.data.quantity
        && reviewOrderItem(restaurantId, orderId).reviewsEnabled == true;
    }

    function canCreateDishReview(restaurantId, reviewId) {
      return !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/dishReviews/$(reviewId))
        && isValidDishReviewPayload(restaurantId, reviewId)
        && publicReviewOrderExists(restaurantId, request.resource.data.orderId)
        && isReviewEligibleOrder(publicReviewOrder(restaurantId, request.resource.data.orderId).data)
        && reviewAccessExists(restaurantId, request.resource.data.orderId)
        && reviewAccessDoc(restaurantId, request.resource.data.orderId).data.restaurantId == restaurantId
        && reviewAccessDoc(restaurantId, request.resource.data.orderId).data.orderId == request.resource.data.orderId
        && reviewAccessDoc(restaurantId, request.resource.data.orderId).data.reviewToken == request.resource.data.reviewToken
        && reviewAccessDoc(restaurantId, request.resource.data.orderId).data.version == 1
        && dishReviewOrderItemMatches(restaurantId, request.resource.data.orderId);
    }

    function isPaidStatus(status) {
      return status is string && status in ["paye", "paid", "validated", "verified"];
    }

    function isValidOrderStatus(status) {
      return status is string && status in ["pending", "preparing", "ready", "served", "picked_up", "cancelled", "completed"];
    }

    function hasLegacyOrderStatusFields(data) {
      return data.keys().hasAny(["status"]);
    }

    function changesLegacyOrderStatusFields() {
      return request.resource.data.keys().hasAny(["status"])
        && resource.data.keys().hasAny(["status"])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]);
    }

    function hasValidOrderStatusIfPresent() {
      return !request.resource.data.keys().hasAny(["orderStatus"])
        || (request.resource.data.orderStatus is string && isValidOrderStatus(request.resource.data.orderStatus));
    }

    function hasValidKitchenStatusIfPresent() {
      return !request.resource.data.keys().hasAny(["kitchenStatus"])
        || (request.resource.data.kitchenStatus is string && isValidOrderStatus(request.resource.data.kitchenStatus));
    }

    function hasCashSessionForVerifiedPayment() {
      return !request.resource.data.keys().hasAny(["paymentStatus"])
        || !(request.resource.data.paymentStatus is string)
        || !isPaidStatus(request.resource.data.paymentStatus)
        || request.resource.data.cashSessionId is string;
    }

    function isCriticalOrderDataChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "amount",
        "total",
        "totalAmount",
        "subtotal",
        "deliveryFee",
        "items"
      ]);
    }

    function isKitchenProductionUpdate() {
      return canUseRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && !changesLegacyOrderStatusFields()
        && hasValidOrderStatusIfPresent()
        && hasValidKitchenStatusIfPresent()
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "orderStatus",
          "kitchenStatus",
          "statusHistory",
          "items",
          "timestamps",
          "updatedAt"
        ]);
    }

    function isTechnicalPaidOrderUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "printedKitchen",
        "printedClient",
        "paymentIntentStatus",
        "paymentVerificationStatus",
        "paymentVerifiedAt",
        "paymentVerifiedBy",
        "sessionActive",
        "completedAt",
        "updatedAt"
      ]);
    }

    function isRefundMarkerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "refunded",
        "refundTotal",
        "updatedAt"
      ]);
    }

    function canUpdateOrder(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.restaurantId == restaurantId
        && !changesLegacyOrderStatusFields()
        && hasValidOrderStatusIfPresent()
        && hasValidKitchenStatusIfPresent()
        && (hasCashSessionForVerifiedPayment() || isKitchenProductionUpdate())
        && (!isCriticalOrderDataChange() || isKitchenProductionUpdate())
        && (
          (
            !isPaidStatus(resource.data.paymentStatus)
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentStatus"])
              || !isPaidStatus(resource.data.paymentStatus)
            )
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && isTechnicalPaidOrderUpdate()
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && isKitchenProductionUpdate()
          )
          || (
            isPaidStatus(resource.data.paymentStatus)
            && canApproveCashSession(restaurantId)
            && isRefundMarkerUpdate()
          )
        );
    }

    function canUpdatePublicTablePaymentRequest() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentRequest", "updatedAt"])
        && (request.resource.data.paymentRequest.status in ["requested", "pending_confirmation"]);
    }

    function canCreatePublicTableSession(restaurantId) {
      return request.resource.data.tableId is string
        && request.resource.data.zoneId is string
        && request.resource.data.status == "active"
        && request.resource.data.closedAt == null
        && request.resource.data.totalAmount == 0
        && request.resource.data.paymentRequest.status == "none"
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId))
        && (
          get(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId)).data.zoneId == request.resource.data.zoneId
          || (
            !get(/databases/$(database)/documents/restaurants/$(restaurantId)/tables/$(request.resource.data.tableId)).data.keys().hasAny(["zoneId"])
            && request.resource.data.zoneId == "main"
          )
        );
    }

    function canTouchPublicTableSession() {
      return resource.data.status == "active"
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActivityAt"]);
    }

    function canUpdatePublicTableSessionTotal() {
      return resource.data.status == "active"
        && request.resource.data.status == resource.data.status
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= resource.data.totalAmount
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["totalAmount", "lastActivityAt"]);
    }

    function canClosePublicTableSession() {
      return resource.data.status == "active"
        && request.resource.data.status == "closed"
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "closedAt", "lastActivityAt"]);
    }

    function canUpdatePublicTableSessionPointer(restaurantId, tableId) {
      return request.resource.data.zoneId is string
        && (
          request.resource.data.zoneId == resource.data.zoneId
          || (
            !resource.data.keys().hasAny(["zoneId"])
            && request.resource.data.zoneId == "main"
          )
        )
        && request.resource.data.status == "occupied"
        && request.resource.data.currentSessionId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "currentSessionId",
          "zoneId",
          "updatedAt",
          "lastActivityAt"
        ])
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.status == "active"
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.tableId == tableId
        && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.currentSessionId)).data.zoneId == request.resource.data.zoneId;
    }

    function canUpdatePublicPaymentIntent(restaurantId) {
      return resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == restaurantId
        && resource.data.source in ["client", "qr", "qr_table", "manual"]
        && !isPaidStatus(resource.data.paymentStatus)
        && (
          request.resource.data.paymentStatus == resource.data.paymentStatus
          || (
            resource.data.paymentStatus == "unpaid"
            && request.resource.data.paymentStatus in ["pending_mobile", "pending", "pending_cash"]
          )
          || (
            resource.data.source != "qr_table"
            && resource.data.paymentStatus == "unpaid"
            && request.resource.data.paymentStatus == "pending_verification"
          )
        )
        && request.resource.data.orderStatus == resource.data.orderStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "source",
          "paymentMethod",
          "paymentMethodCode",
          "paymentProvider",
          "paymentType",
          "paymentIntentStatus",
          "paymentStatus",
          "paymentCode",
          "paymentInstruction",
          "needsCashCollection",
          "paymentVerificationStatus",
          "paymentVerificationRequestedAt",
          "updatedAt"
        ])
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentIntentStatus in ["pending", "submitted"];
    }

    function canAppendActiveDineInOrder(restaurantId) {
      return resource.data.restaurantId == restaurantId
        && request.resource.data.restaurantId == restaurantId
        && resource.data.source in ["qr", "qr_table"]
        && resource.data.orderType == "dine_in"
        && request.resource.data.orderType == resource.data.orderType
        && resource.data.sessionActive == true
        && !isPaidStatus(resource.data.paymentStatus)
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.zoneId == resource.data.zoneId
        && request.resource.data.items is list
        && request.resource.data.items.size() >= resource.data.items.size()
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "subtotal",
          "total",
          "totalAmount",
          "updatedAt"
        ])
        && request.resource.data.sessionActive == true
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.orderStatus == resource.data.orderStatus
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId)).data.status == "active"
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(resource.data.sessionId)).data.tableId == resource.data.tableId;
    }

    function isValidPaymentSource(source) {
      return source in ["pos", "qr_table", "delivery"];
    }

    function isValidPaymentType(type) {
      return type in ["cash", "mobile_money"];
    }

    function isValidPaymentLedgerStatus(status) {
      return status in ["pending", "confirmed", "failed", "refunded", "voided"];
    }

    function isValidPaymentCreateTimestamps(data) {
      return data.createdAt is timestamp
        && (
          data.status == "confirmed"
          ? (data.confirmedAt is timestamp && data.confirmedBy == request.auth.uid)
          : (!data.keys().hasAny(["confirmedAt"]) || data.confirmedAt == null)
        )
        && (
          data.status == "failed"
          ? (data.failedAt is timestamp && data.failedBy == request.auth.uid && data.failureReason is string)
          : (!data.keys().hasAny(["failedAt"]) || data.failedAt == null)
        );
    }

    function isValidPaymentStatusTransition() {
      return resource.data.status == "pending"
        && (
          (
            request.resource.data.status == "confirmed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "confirmedAt", "confirmedBy"])
            && request.resource.data.confirmedAt is timestamp
            && request.resource.data.confirmedBy == request.auth.uid
          )
          || (
            request.resource.data.status == "failed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "failedAt", "failedBy", "failureReason"])
            && request.resource.data.failedAt is timestamp
            && request.resource.data.failedBy == request.auth.uid
            && request.resource.data.failureReason is string
          )
        );
    }

    function hasOpenCashSession(restaurantId, sessionId, cashierId) {
      return sessionId is string
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.status == "open"
        && (
          get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.cashierId == cashierId
          || get(/databases/$(database)/documents/restaurants/$(restaurantId)/cashSessions/$(sessionId)).data.userId == cashierId
        );
    }

    function isValidPaymentCreate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && request.resource.data.orderId is string
        && request.resource.data.sessionId is string
        && request.resource.data.cashierId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && isValidPaymentSource(request.resource.data.source)
        && isValidPaymentType(request.resource.data.type)
        && isValidPaymentLedgerStatus(request.resource.data.status)
        && request.resource.data.idempotencyKey is string
        && isValidPaymentCreateTimestamps(request.resource.data)
        && (
          request.resource.data.type == "cash"
          ? request.resource.data.provider == null
          : (request.resource.data.provider == null || request.resource.data.provider is string)
        )
        && hasOpenCashSession(restaurantId, request.resource.data.sessionId, request.resource.data.cashierId);
    }

    function isCashSessionAggregateUpdate(restaurantId) {
      return canUseRestaurant(restaurantId)
        && resource.data.status == "open"
        && request.resource.data.status == "open"
        && (resource.data.cashierId == request.auth.uid || resource.data.userId == request.auth.uid)
        && request.resource.data.restaurantId == restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "totalCash",
          "totalMobile",
          "totalMobileMoney",
          "totalOrders",
          "totalPayments",
          "totalConfirmed",
          "totalsByProvider",
          "totalsBySource",
          "updatedAt"
        ]);
    }

    function canUseRestaurant(restaurantId) {
      return isSuperAdmin()
        || isRestaurantMember(restaurantId)
        || isRestaurantStaff(restaurantId)
        || isRestaurantOwnerEmail(restaurantId);
    }

    function hasValidRestaurantGeoLocation() {
      return !("location" in request.resource.data)
        || request.resource.data.location is map
        && (!("address" in request.resource.data.location) || request.resource.data.location.address is string)
        && (!("googleMapsUrl" in request.resource.data.location) || request.resource.data.location.googleMapsUrl is string)
        && (!("lat" in request.resource.data.location) || request.resource.data.location.lat == null || (request.resource.data.location.lat is number && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90))
        && (!("lng" in request.resource.data.location) || request.resource.data.location.lng == null || (request.resource.data.location.lng is number && request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180));
    }

    function hasValidRestaurantLocationFields() {
      return request.resource.data.phone is string
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() > 0
        && request.resource.data.countryName is string
        && request.resource.data.cityId is string
        && request.resource.data.cityName is string
        && request.resource.data.cityName.size() > 0
        && request.resource.data.communeId is string
        && request.resource.data.communeName is string
        && (!("districtName" in request.resource.data) || request.resource.data.districtName is string)
        && (!("address" in request.resource.data) || request.resource.data.address is string)
        && hasValidRestaurantGeoLocation();
    }

    function hasValidRestaurantOpeningHoursUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "openingHours",
          "timezone",
          "updatedAt"
        ])
        && (!("openingHours" in request.resource.data) || request.resource.data.openingHours is map)
        && (!("timezone" in request.resource.data) || request.resource.data.timezone is string)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function hasValidRestaurantBrandingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "logoUrl",
          "coverImage",
          "coverImageUrl",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!("logoUrl" in request.resource.data) || request.resource.data.logoUrl is string)
        && (!("coverImage" in request.resource.data) || request.resource.data.coverImage is string)
        && (!("coverImageUrl" in request.resource.data) || request.resource.data.coverImageUrl is string)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function canUpdateRestaurantBranding(restaurantId) {
      return (
          isRestaurantOwner(restaurantId)
          || (
            userExists()
            && userDoc().data.restaurantId == restaurantId
            && userDoc().data.role == "owner"
          )
        )
        && hasValidRestaurantBrandingUpdate();
    }

    function hasValidPlatformPublicFooter() {
      return !("publicFooter" in request.resource.data)
        || request.resource.data.publicFooter is map
        && request.resource.data.publicFooter.description is string
        && request.resource.data.publicFooter.phone is string
        && request.resource.data.publicFooter.whatsapp is string
        && request.resource.data.publicFooter.email is string
        && request.resource.data.publicFooter.officeAddress is string
        && request.resource.data.publicFooter.socialLinks is map
        && request.resource.data.publicFooter.socialLinks.facebook is string
        && request.resource.data.publicFooter.socialLinks.instagram is string
        && request.resource.data.publicFooter.socialLinks.tiktok is string
        && request.resource.data.publicFooter.socialLinks.linkedin is string
        && request.resource.data.publicFooter.socialLinks.youtube is string
        && request.resource.data.publicFooter.socialLinks.twitter is string
        && request.resource.data.publicFooter.legalLinks is map
        && request.resource.data.publicFooter.legalLinks.privacy is string
        && request.resource.data.publicFooter.legalLinks.terms is string
        && request.resource.data.publicFooter.legalLinks.legalNotice is string;
    }

    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSuperAdmin()
        && hasValidRestaurantLocationFields();
      allow update: if (isSuperAdmin()
          && hasValidRestaurantGeoLocation())
        || (
          canManageRestaurantMenu(restaurantId)
          && hasValidRestaurantOpeningHoursUpdate()
        )
        || canUpdateRestaurantBranding(restaurantId);
      allow delete: if isSuperAdmin();

      match /staff/{staffId} {
        allow read: if canUseRestaurant(restaurantId);
        allow write: if isSuperAdmin() || isRestaurantOwner(restaurantId);
      }

      match /categories/{categoryId} {
        allow get, list: if true;
        allow create: if canManageRestaurantMenu(restaurantId)
          && request.resource.data.reviewsEnabled is bool;
        allow update: if canManageRestaurantMenu(restaurantId)
          && (
            request.resource.data.reviewsEnabled is bool
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["order", "updatedAt"])
          );
        allow delete: if canManageRestaurantMenu(restaurantId);
      }

      match /products/{productId} {
        allow get, list: if true;
        allow create: if canManageRestaurantMenu(restaurantId)
          && hasValidOperationalAvailability(request.resource.data)
          && hasValidPortionControl(request.resource.data)
          && request.resource.data.reviewsEnabled is bool
          && request.resource.data.reviewsPolicy in ["inherit", "enabled", "disabled"]
          && (!("stockArticleId" in request.resource.data)
              || (
                request.resource.data.stockArticleId is string
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.stockArticleId)).data.status == "active"
              ))
          && (!("quantityPerSale" in request.resource.data)
              || (
                request.resource.data.quantityPerSale is number
                && request.resource.data.quantityPerSale > 0
                && request.resource.data.stockArticleId is string
                && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.stockArticleId)).data.trackingMode == "AUTOMATIC_SIMPLE"
              ))
          && (!("preparationMode" in request.resource.data)
              || request.resource.data.preparationMode in ["kitchen", "direct", "bar"]);
        allow update: if (
          canManageRestaurantMenu(restaurantId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["operationalAvailability", "portionControl"])
          && hasValidOperationalAvailability(request.resource.data)
          && hasValidPortionControl(request.resource.data)
          && hasValidOperationalAvailabilityAudit()
          && (
              (request.resource.data.reviewsEnabled is bool
                && request.resource.data.reviewsPolicy in ["inherit", "enabled", "disabled"])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["order", "updatedAt"])
            )
            && (!("stockArticleId" in request.resource.data)
                || (
                  request.resource.data.stockArticleId is string
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.stockArticleId)).data.status == "active"
                ))
            && (!("quantityPerSale" in request.resource.data)
                || (
                  request.resource.data.quantityPerSale is number
                  && request.resource.data.quantityPerSale > 0
                  && request.resource.data.stockArticleId is string
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.stockArticleId)).data.trackingMode == "AUTOMATIC_SIMPLE"
                ))
            && (!("preparationMode" in request.resource.data)
                || request.resource.data.preparationMode in ["kitchen", "direct", "bar"])
          );
        allow delete: if canManageRestaurantMenu(restaurantId);
      }

      match /availabilityServiceState/{documentId} {
        allow read: if canUseRestaurant(restaurantId);
        allow write: if false;
      }

      match /availabilityHistory/{historyId} {
        allow read: if canManageRestaurantMenu(restaurantId)
          || (
            isRestaurantKitchen(restaurantId)
            && resource.data.preparationMode == "kitchen"
          );
        allow write: if false;
      }

      match /menuItems/{menuItemId} {
        allow get, list: if true;
        allow write: if canManageRestaurantMenu(restaurantId)
          && (!("preparationMode" in request.resource.data) 
              || request.resource.data.preparationMode in ["kitchen", "direct", "bar"]);
      }

      match /inventory/{inventoryId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow write: if canUseRestaurant(restaurantId);
      }

      match /stockItemsV2/{articleId} {
        allow get, list: if canReadStockArticleReferential(restaurantId)
          || hasStockServiceRole(restaurantId);
        allow create: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.keys().hasOnly([
            "restaurantId",
            "name",
            "description",
            "categoryId",
            "baseUnit",
            "packagings",
            "lowStockThreshold",
            "outOfStockThreshold",
            "trackingMode",
            "status",
            "createdAt",
            "updatedAt",
            "createdBy",
            "updatedBy",
            "migration"
          ])
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (request.resource.data.categoryId == null
            || request.resource.data.categoryId is string)
          && request.resource.data.baseUnit in ["unit", "kg", "g", "l", "ml"]
          && request.resource.data.packagings is list
          && request.resource.data.lowStockThreshold is number
          && request.resource.data.lowStockThreshold >= 0
          && request.resource.data.outOfStockThreshold is number
          && request.resource.data.outOfStockThreshold >= 0
          && request.resource.data.outOfStockThreshold <= request.resource.data.lowStockThreshold
          && request.resource.data.trackingMode in [
            "CONTROLLED",
            "AUTOMATIC_SIMPLE",
            "NONE"
          ]
          && request.resource.data.status == "active"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId))
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId)).data.restaurantId == restaurantId
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId)).data.articleId == articleId
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId)).data.quantity == 0
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId)).data.unit == request.resource.data.baseUnit
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockBalancesV2/$(articleId)).data.version == 1;
        allow update: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.keys().hasOnly([
            "restaurantId",
            "name",
            "description",
            "categoryId",
            "baseUnit",
            "packagings",
            "lowStockThreshold",
            "outOfStockThreshold",
            "trackingMode",
            "status",
            "createdAt",
            "updatedAt",
            "createdBy",
            "updatedBy",
            "migration"
          ])
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (request.resource.data.categoryId == null
            || request.resource.data.categoryId is string)
          && request.resource.data.baseUnit in ["unit", "kg", "g", "l", "ml"]
          && request.resource.data.packagings is list
          && request.resource.data.lowStockThreshold is number
          && request.resource.data.lowStockThreshold >= 0
          && request.resource.data.outOfStockThreshold is number
          && request.resource.data.outOfStockThreshold >= 0
          && request.resource.data.outOfStockThreshold <= request.resource.data.lowStockThreshold
          && request.resource.data.trackingMode in [
            "CONTROLLED",
            "AUTOMATIC_SIMPLE",
            "NONE"
          ]
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /stockItemCostsV2/{articleId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create, update: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.keys().hasOnly([
            "restaurantId",
            "articleId",
            "referenceCost",
            "updatedAt",
            "updatedBy"
          ])
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.articleId == articleId
          && request.resource.data.referenceCost is number
          && request.resource.data.referenceCost >= 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if canReadRestaurantBusinessDocs(restaurantId);
      }

      match /stockItemCategoriesV2/{categoryId} {
        allow get, list: if canReadStockArticleReferential(restaurantId);
        allow create: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.keys().hasOnly([
            "restaurantId",
            "name",
            "description",
            "sortOrder",
            "status",
            "createdAt",
            "updatedAt",
            "createdBy",
            "updatedBy"
          ])
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sortOrder is number
          && request.resource.data.sortOrder >= 0
          && request.resource.data.status == "active"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sortOrder is number
          && request.resource.data.sortOrder >= 0
          && request.resource.data.status in ["active", "archived"]
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /stockBalancesV2/{articleId} {
        allow get, list: if canReadStockArticleReferential(restaurantId)
          || hasStockServiceRole(restaurantId);
        allow create: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.articleId == articleId
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 0
          && request.resource.data.unit in ["unit", "kg", "g", "l", "ml"]
          && request.resource.data.version == 1
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(articleId)).data.status == "active"
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(articleId)).data.trackingMode in ["CONTROLLED", "AUTOMATIC_SIMPLE"];
        allow update: if isLinkedStockBalanceUpdate(restaurantId)
          || isAutomaticServingBalanceUpdate(restaurantId);
        allow delete: if false;
      }

      match /stockOperationsV2/{operationId} {
        allow get, list: if canReadStockArticleReferential(restaurantId);
        allow create: if (
          canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.type != "AUTOMATIC_DEDUCTION"
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.articleId is string
          && request.resource.data.type in [
            "APPROVISIONNEMENT",
            "CONTROLE_PHYSIQUE",
            "PERTE",
            "CORRECTION_POSITIVE",
            "CORRECTION_NEGATIVE",
            "AUTOMATIC_DEDUCTION",
            "AUTOMATIC_COMPENSATION"
          ]
          && request.resource.data.quantityBefore is number
          && request.resource.data.quantityAfter is number
          && request.resource.data.quantityAfter >= 0
          && request.resource.data.variation is number
          && request.resource.data.quantityAfter
            == request.resource.data.quantityBefore + request.resource.data.variation
          && request.resource.data.unit in ["unit", "kg", "g", "l", "ml"]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.idempotencyKey is string
          && request.resource.data.idempotencyKey.size() > 0
          && (
            request.resource.data.type != "CONTROLE_PHYSIQUE"
            || get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.trackingMode == "CONTROLLED"
          )
          && (
            !(request.resource.data.type in [
              "AUTOMATIC_DEDUCTION",
              "AUTOMATIC_COMPENSATION"
            ])
            || (
              request.resource.data.productId is string
              && request.resource.data.businessReference is string
              && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.trackingMode == "AUTOMATIC_SIMPLE"
            )
          )
          && (
            request.resource.data.type != "AUTOMATIC_COMPENSATION"
            || request.resource.data.originalOperationId is string
          ))
          || isAutomaticServingOperationCreate(restaurantId);
        allow update, delete: if false;
      }

      match /stockIdempotencyV2/{idempotencyKey} {
        allow get: if canReadRestaurantBusinessDocs(restaurantId)
          || hasStockServiceRole(restaurantId);
        allow list: if false;
        allow create: if (canReadRestaurantBusinessDocs(restaurantId)
          || hasStockServiceRole(restaurantId))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.operationId is string
          && request.resource.data.fingerprint is string
          && request.resource.data.createdBy == request.auth.uid
          && existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/stockOperationsV2/$(request.resource.data.operationId));
        allow update, delete: if false;
      }

      match /stockServingProgressV2/{progressId} {
        allow get: if hasStockServiceRole(restaurantId);
        allow list: if false;
        allow create, update: if hasStockServiceRole(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.orderId is string
          && request.resource.data.orderItemId is string
          && request.resource.data.productId is string
          && request.resource.data.articleId is string
          && request.resource.data.associationId is string
          && request.resource.data.servedQuantity is number
          && request.resource.data.servedQuantity > 0
          && request.resource.data.lastOperationId is string
          && request.resource.data.updatedBy == request.auth.uid
          && (
            !exists(/databases/$(database)/documents/restaurants/$(restaurantId)/stockServingProgressV2/$(progressId))
            || request.resource.data.servedQuantity >= resource.data.servedQuantity
          )
          && getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(request.resource.data.orderId)/orderItems/$(request.resource.data.orderItemId)).data.servedQuantity
            == request.resource.data.servedQuantity;
        allow delete: if false;
      }

      match /stockOperationCostsV2/{operationId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.operationId == operationId
          && request.resource.data.totalCost is number
          && request.resource.data.totalCost >= 0
          && request.resource.data.unitCost is number
          && request.resource.data.unitCost >= 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow update, delete: if false;
      }

      match /stockAutomaticAssociationsV2/{associationId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId)
          || hasStockServiceRole(restaurantId);
        allow create: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.productId is string
          && request.resource.data.articleId is string
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.unit in ["unit", "kg", "g", "l", "ml"]
          && request.resource.data.status == "active"
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.restaurantId == restaurantId
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.status == "active"
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.trackingMode == "AUTOMATIC_SIMPLE"
          && existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/products/$(request.resource.data.productId));
        allow update: if canReadRestaurantBusinessDocs(restaurantId)
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.articleId == resource.data.articleId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.status in ["active", "inactive"]
          && request.resource.data.updatedBy == request.auth.uid
          && get(/databases/$(database)/documents/restaurants/$(restaurantId)/stockItemsV2/$(request.resource.data.articleId)).data.trackingMode == "AUTOMATIC_SIMPLE";
        allow delete: if false;
      }

      match /stockAutomaticAnomaliesV2/{anomalyId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create, update, delete: if false;
      }

      match /inventoryItems/{itemId} {
        allow get, list: if canReadRestaurantInventoryItems(restaurantId);
        allow create: if canWriteRestaurantInventoryItems(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.unit in ["pièce", "kg", "litre"]
          && request.resource.data.stockEstimated is number
          && request.resource.data.stockEstimated >= 0
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold is number)
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold >= 0)
          && (!("preparationMode" in request.resource.data) 
              || request.resource.data.preparationMode in ["kitchen", "direct", "bar"])
          && request.resource.data.lastCountedStock is number
          && request.resource.data.lastCountedStock >= 0
          && request.resource.data.avgDailyConsumption is number
          && request.resource.data.avgDailyConsumption >= 0
          && request.resource.data.costPerUnit is number
          && request.resource.data.costPerUnit >= 0
          && request.resource.data.lossRate is number
          && request.resource.data.lossRate >= 0
          && request.resource.data.lossRate <= 1;
        allow update: if (
          canWriteRestaurantInventoryItems(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.unit in ["pièce", "kg", "litre"]
          && request.resource.data.stockEstimated is number
          && request.resource.data.stockEstimated >= 0
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold is number)
          && (!("minThreshold" in request.resource.data) || request.resource.data.minThreshold >= 0)
          && (!("preparationMode" in request.resource.data) 
              || request.resource.data.preparationMode in ["kitchen", "direct", "bar"])
          && request.resource.data.costPerUnit is number
          && request.resource.data.costPerUnit >= 0
          && request.resource.data.lossRate is number
          && request.resource.data.lossRate >= 0
          && request.resource.data.lossRate <= 1
        ) || isInventorySaleDecrement(restaurantId)
          || isInventorySupplyUpdate(restaurantId)
          || isInventoryThresholdUpdate(restaurantId)
          || isInventoryConsumptionStatsUpdate(restaurantId);
        allow delete: if isSuperAdmin();
      }

      match /inventoryMovements/{movementId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["supply", "adjustment", "sale"]
          && request.resource.data.inventoryItemId is string
          && request.resource.data.quantity is number
          && (
            (
              request.resource.data.type in ["supply", "adjustment"]
              && request.resource.data.quantity > 0
              && request.resource.data.createdBy == request.auth.uid
            )
            || (
              request.resource.data.type == "sale"
              && request.resource.data.quantity < 0
              && request.resource.data.source == "system"
            )
          )
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /suppliers/{supplierId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantExpenseDocs(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if canWriteRestaurantExpenseDocs(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0;
        allow delete: if isSuperAdmin();
      }

      match /expenses/{expenseId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantExpenseDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["supply", "salary", "other"]
          && request.resource.data.paymentStatus in ["paid", "partial", "unpaid"]
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidAmount is number
          && request.resource.data.paidAmount >= 0
          && request.resource.data.paidAmount <= request.resource.data.amount
          && request.resource.data.validated == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if false;
      }

      match /expenseLogs/{expenseId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantExpenseDocs(restaurantId)
          && request.resource.data.expenseId == expenseId
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /supplierPayments/{paymentId} {
        allow get, list: if canReadRestaurantBusinessDocs(restaurantId);
        allow create: if canWriteRestaurantExpenseDocs(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.supplierId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /inventoryAlerts/{alertId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.type in ["low_stock", "incoherent_stock", "missing_cost"]
          && request.resource.data.itemId is string
          && request.resource.data.message is string
          && request.resource.data.severity in ["low", "medium", "high"]
          && request.resource.data.resolved is bool
          && request.resource.data.createdAt is timestamp;
        allow update: if canUseRestaurant(restaurantId)
          && request.resource.data.resolved is bool;
        allow delete: if isSuperAdmin();
      }

      match /inventoryLogs/{logId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.paymentId == logId
          && request.resource.data.decrementCount is number
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /customers/{customerId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow write: if canUseRestaurant(restaurantId);
      }

      match /reviewAccess/{orderId} {
        // Issued by the authenticated server boundary only.
        allow create: if false;
        allow get, list, update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow get: if canReadRestaurantReviewDocs(restaurantId);
        allow list: if canReadRestaurantReviewDocs(restaurantId);
        allow create: if canCreateRestaurantReview(restaurantId, reviewId);
        allow update, delete: if false;
      }

      match /dishReviews/{dishReviewId} {
        allow get: if canReadRestaurantReviewDocs(restaurantId);
        allow list: if canReadRestaurantReviewDocs(restaurantId);
        allow create: if canCreateDishReview(restaurantId, dishReviewId);
        allow update, delete: if false;
      }

      match /reviewAggregates/{aggregateId} {
        allow get, list: if canReadRestaurantReviewDocs(restaurantId);
        allow create, update, delete: if false;
      }

      match /cashierSessions/{sessionId} {
        allow get, list: if canUseRestaurant(restaurantId);
        // Legacy format: readable during the compatibility window, frozen for
        // every client. Migration/archival is performed by an Admin boundary.
        allow create, update, delete: if false;
      }

      match /cashSessions/{sessionId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if (
          canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && (request.resource.data.cashierId == request.auth.uid || request.resource.data.userId == request.auth.uid)
          && request.resource.data.status == "open"
        ) || (
          canApproveCashSession(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId is string
          && request.resource.data.status == "open"
          && request.resource.data.approvedBy == request.auth.uid
        );
        allow update: if isCashSessionAggregateUpdate(restaurantId)
          || (
            resource.data.status != "validated"
            && request.resource.data.restaurantId == restaurantId
            && request.resource.data.status in ["open", "closed", "pending_validation", "validated"]
            && (
              canApproveCashSession(restaurantId)
              || (
                canUseRestaurant(restaurantId)
                && (resource.data.cashierId == request.auth.uid || resource.data.userId == request.auth.uid)
                && resource.data.status == "open"
                && request.resource.data.status in ["closed", "pending_validation"]
                && request.resource.data.validatedByManager == false
              )
            )
          );
        allow delete: if isSuperAdmin();
      }

      match /payments/{paymentId} {
        allow get, list: if canApproveCashSession(restaurantId) || canUseRestaurant(restaurantId);
        // Financial ledger mutations are server-only. Legacy documents remain
        // readable, but clients cannot create, confirm, void or refund entries.
        allow create, update: if false;
        allow delete: if false;
      }

      match /cashHandovers/{handoverId} {
        allow get: if canApproveCashSession(restaurantId)
          || (
            canUseRestaurant(restaurantId)
            && resource.data.cashierId == request.auth.uid
          );
        allow list: if canApproveCashSession(restaurantId)
          || (
            canUseRestaurant(restaurantId)
            && resource.data.cashierId == request.auth.uid
          );
        // Submission, review and treasury posting are atomic server commands.
        allow create, update, delete: if false;
      }

      match /treasuryAccounts/{accountId} {
        allow get, list: if canApproveCashSession(restaurantId) || canUseRestaurant(restaurantId);
        allow create: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && accountId in ["cash", "mobile_money", "bank"]
          && request.resource.data.id == accountId
          && request.resource.data.name is string
          && request.resource.data.kind in ["cash", "mobile_money", "bank"]
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.currency is string
          && request.resource.data.active is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && request.resource.data.id == resource.data.id
          && request.resource.data.name is string
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.currency is string
          && request.resource.data.active is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /cashMovements/{movementId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if (canApproveCashSession(restaurantId) || canWriteRestaurantBusinessDocs(restaurantId))
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.type in ["deposit", "expense", "transfer"]
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.source in ["session", "manual", "expense", "payment", "supplier_payment", "transfer"]
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          // Session deposits are emitted only by REVIEW_HANDOVER on the server.
          && request.resource.data.source != "session"
          && (
            request.resource.data.type != "deposit"
            || request.resource.data.source != "session"
          );
        allow update, delete: if false;
      }

      match /cashSessionRequests/{requestId} {
        allow get, list: if canUseRestaurant(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId == request.auth.uid
          && request.resource.data.status == "pending";
        allow update: if canApproveCashSession(restaurantId)
          && request.resource.data.restaurantId == restaurantId
          && request.resource.data.cashierId == resource.data.cashierId
          && request.resource.data.status in ["pending", "approved", "rejected"];
        allow delete: if isSuperAdmin();
      }

      match /tables/{tableId} {
        allow get, list: if true;
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.name is string
          && request.resource.data.zoneId is string
          && request.resource.data.status == "free"
          && request.resource.data.currentSessionId == null;
        allow update: if canUseRestaurant(restaurantId);
        allow delete: if isSuperAdmin();
      }

      match /tableSessions/{sessionId} {
        allow get: if canUseRestaurant(restaurantId) || resource.data.status == "active";
        allow list: if canUseRestaurant(restaurantId);
        allow create: if (
          canUseRestaurant(restaurantId)
          && request.resource.data.tableId is string
          && request.resource.data.zoneId is string
          && request.resource.data.status == "active"
          && request.resource.data.closedAt == null
        );
        allow update: if canUseRestaurant(restaurantId);
        allow delete: if isSuperAdmin();
      }

      match /visits/{visitId} {
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.tableId is string
          && request.resource.data.sessionId is string;
        allow get, list: if canUseRestaurant(restaurantId);
        allow update, delete: if isSuperAdmin();
      }

      match /images/{imageId} {
        allow get, list: if canManageRestaurantMenu(restaurantId);
        allow create: if canManageRestaurantMenu(restaurantId)
          && request.resource.data.url is string
          && request.resource.data.publicId is string;
        allow update, delete: if canManageRestaurantMenu(restaurantId);
      }

      match /orders/{orderId} {
        // Public canonical creation is server-only. Admin SDK bypasses Rules.
        allow create: if canUseRestaurant(restaurantId)
          &&
          request.resource.data.restaurantId == restaurantId
          && request.resource.data.items is list
          && request.resource.data.total is number
          && !hasLegacyOrderStatusFields(request.resource.data)
          && request.resource.data.orderStatus is string
          && isValidOrderStatus(request.resource.data.orderStatus)
          && hasValidKitchenStatusIfPresent()
          && hasCashSessionForVerifiedPayment()
          && (
            (
              request.resource.data.source in ["client", "qr", "qr_table", "manual"]
              && (
                (
                  // Dine-in orders require a table session
                  request.resource.data.orderType == "dine_in"
                  && request.resource.data.sessionId is string
                  && request.resource.data.tableId is string
                  && request.resource.data.zoneId is string
                  && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId))
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.status == "active"
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.tableId == request.resource.data.tableId
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.zoneId == request.resource.data.zoneId
                )
                ||
                (
                  // Takeaway and delivery don't require table sessions
                  request.resource.data.orderType in ["takeaway", "pickup", "delivery"]
                  && request.resource.data.sessionId == null
                  && request.resource.data.tableId == null
                )
              )
            )
            || (
              canUseRestaurant(restaurantId)
              && request.resource.data.source == "pos"
              && (
                !(request.resource.data.tableId is string)
                || (
                  request.resource.data.sessionId is string
                  && request.resource.data.zoneId is string
                  && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId))
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.status == "active"
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.tableId == request.resource.data.tableId
                  && get(/databases/$(database)/documents/restaurants/$(restaurantId)/tableSessions/$(request.resource.data.sessionId)).data.zoneId == request.resource.data.zoneId
                )
              )
            )
          );

        allow get: if (
            isSignedIn()
            && resource.data.restaurantId == restaurantId
            && resource.data.createdBy == request.auth.uid
            && resource.data.source in ["qr_table", "public_takeaway", "public_delivery"]
          )
          || canUseRestaurant(restaurantId);

        allow list: if canUseRestaurant(restaurantId);
        allow update: if canUpdateOrder(restaurantId);
        allow delete: if false;

        match /auditLogs/{logId} {
          allow get, list: if canApproveCashSession(restaurantId);
          allow create: if canUseRestaurant(restaurantId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.orderId == orderId
            && request.resource.data.action is string
            && request.resource.data.before is map
            && request.resource.data.after is map
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }

        match /costSnapshot/{snapshotId} {
          allow get, list: if canReadRestaurantInventoryItems(restaurantId);
          allow create: if canUseRestaurant(restaurantId)
            && request.resource.data.paymentId == snapshotId
            && request.resource.data.totalCost is number
            && request.resource.data.totalCost >= 0
            && request.resource.data.totalSales is number
            && request.resource.data.margin is number
            && request.resource.data.createdDate is string
            && request.resource.data.createdAt is timestamp;
          allow update, delete: if false;
        }

        match /orderItems/{itemId} {
          allow get, list: if canUseRestaurant(restaurantId);
          allow create: if canUseRestaurant(restaurantId);
          allow update: if isServedOrderItemUpdate(restaurantId, orderId, itemId)
            || (
              canUseRestaurant(restaurantId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                "status",
                "servedQuantity",
                "servedAt",
                "servedBy"
              ])
            );
          allow delete: if isSuperAdmin();
        }
      }

      match /auditLogs/{logId} {
        allow get, list: if canApproveCashSession(restaurantId);
        allow create: if canUseRestaurant(restaurantId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.orderId is string
          && request.resource.data.action is string
          && request.resource.data.before is map
          && request.resource.data.after is map
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /refunds/{refundId} {
        allow get, list: if canApproveCashSession(restaurantId);
        allow create: if canApproveCashSession(restaurantId)
          && request.resource.data.orderId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.reason is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin();
      allow list: if isSuperAdmin();

      allow create: if request.auth.uid == userId
        || isSuperAdmin()
        || (
          request.resource.data.restaurantId is string
          && canUseRestaurant(request.resource.data.restaurantId)
        );

      allow update: if request.auth.uid == userId
        || isSuperAdmin()
        || (
          resource.data.restaurantId is string
          && canUseRestaurant(resource.data.restaurantId)
        );

      allow delete: if isSuperAdmin();
    }

    match /restaurantSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isSuperAdmin()
        || canUseRestaurant(resource.data.restaurantId);
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /invitations/{id} {
      allow create: if isSuperAdmin();
      allow get: if true;
      allow list: if false;
      allow update: if true;
    }

    match /contactRequests/{id} {
      allow create: if true;
      allow get, list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /plans/{planId} {
      allow read, write: if isSuperAdmin();
    }

    match /platformSettings/{settingsId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.primaryColor is string
        && request.resource.data.secondaryColor is string
        && request.resource.data.supportEmail is string
        && request.resource.data.supportPhone is string
        && request.resource.data.supportWhatsapp is string
        && request.resource.data.logoUrl is string
        && request.resource.data.faviconUrl is string
        && request.resource.data.maintenanceMode is bool
        && hasValidPlatformPublicFooter();
      allow delete: if isSuperAdmin();
    }

    match /platformMedia/{mediaId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.url is string
        && request.resource.data.publicId is string
        && request.resource.data.type is string;
      allow update: if isSuperAdmin()
        && request.resource.data.url is string
        && request.resource.data.publicId is string
        && request.resource.data.type is string;
      allow delete: if isSuperAdmin();
    }

    match /platformMenuPacks/{packId} {
      allow get, list: if canReadPlatformMenuLibrary();
      allow create, update, delete: if isSuperAdmin();
    }

    match /platformMenuCategories/{categoryTemplateId} {
      allow get, list: if canReadPlatformMenuLibrary();
      allow create, update: if isSuperAdmin()
        && request.resource.data.reviewsEnabled is bool;
      allow delete: if isSuperAdmin();
    }

    match /platformMenuProducts/{productTemplateId} {
      allow get, list: if canReadPlatformMenuLibrary();
      allow create, update: if isSuperAdmin()
        && request.resource.data.reviewsEnabled is bool
        && request.resource.data.reviewsPolicy in ["inherit", "enabled", "disabled"]
        && (!("preparationMode" in request.resource.data)
          || request.resource.data.preparationMode in ["kitchen", "direct", "bar"]);
      allow delete: if isSuperAdmin();
    }

    match /platformCountries/{countryId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin()
        && countryId == request.resource.data.code
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.currency is string
        && request.resource.data.dialCode is string
        && request.resource.data.isActive is bool
        && (!("order" in request.resource.data) || request.resource.data.order is number)
        && request.resource.data.createdAt is timestamp;
      allow update: if isSuperAdmin()
        && countryId == request.resource.data.code
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.currency is string
        && request.resource.data.dialCode is string
        && request.resource.data.isActive is bool
        && (!("order" in request.resource.data) || request.resource.data.order is number);
      allow delete: if isSuperAdmin();

      match /cities/{cityId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSuperAdmin()
          && request.resource.data.name is string
          && request.resource.data.normalizedName is string
          && request.resource.data.isActive is bool
          && request.resource.data.order is number;
        allow delete: if isSuperAdmin();

        match /communes/{communeId} {
          allow get, list: if isSignedIn();
          allow create, update: if isSuperAdmin()
            && request.resource.data.name is string
            && request.resource.data.normalizedName is string
            && request.resource.data.isActive is bool
            && request.resource.data.order is number;
          allow delete: if isSuperAdmin();
        }
      }
    }

    match /platformPaymentMethods/{methodId} {
      allow get, list: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.code is string
        && request.resource.data.logoUrl is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.isActive is bool;
      allow update: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.code is string
        && request.resource.data.logoUrl is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin();
    }

    match /platformPaymentVariants/{variantId} {
      allow get, list: if true;
      allow create: if isSuperAdmin()
        && request.resource.data.methodCode is string
        && request.resource.data.countryCode is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.ussdTemplate is string
        && request.resource.data.requiresMerchant is bool
        && request.resource.data.requiresPhone is bool
        && request.resource.data.isActive is bool;
      allow update: if isSuperAdmin()
        && request.resource.data.methodCode is string
        && request.resource.data.countryCode is string
        && request.resource.data.type in ["ussd", "link"]
        && request.resource.data.ussdTemplate is string
        && request.resource.data.requiresMerchant is bool
        && request.resource.data.requiresPhone is bool
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin();
    }

    match /restaurantPaymentConfigs/{configId} {
      allow get, list: if true;
      allow create: if canUseRestaurant(request.resource.data.restaurantId)
        && request.resource.data.restaurantId is string
        && request.resource.data.methodCode is string
        && request.resource.data.merchantNumber is string
        && request.resource.data.isActive is bool;
      allow update: if canUseRestaurant(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.methodCode is string
        && request.resource.data.merchantNumber is string
        && request.resource.data.isActive is bool;
      allow delete: if isSuperAdmin()
        || canUseRestaurant(resource.data.restaurantId);
    }

    match /platform/{docId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Derived public Marketplace read model — client-side sync (Spark-compatible).
    // Manager/owner writes their own restaurant projections; public reads discoverable offers.
    match /marketplaceDishOffers/{offerId} {
      allow read: if resource.data.discoverable == true
        && resource.data.schemaVersion == 1;

      allow create: if canManageRestaurantMenu(request.resource.data.restaurantId)
        && request.resource.data.restaurantId is string
        && request.resource.data.productId is string
        && request.resource.data.marketplaceCategoryId is string
        && request.resource.data.discoverable is bool
        && request.resource.data.schemaVersion == 1;

      allow update: if canManageRestaurantMenu(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.restaurantId is string
        && request.resource.data.productId is string
        && request.resource.data.marketplaceCategoryId is string
        && request.resource.data.discoverable is bool
        && request.resource.data.schemaVersion == 1;

      allow delete: if canManageRestaurantMenu(resource.data.restaurantId);
    }

    match /marketplaceFoodCategories/{categoryId} {
      allow read: if isSuperAdmin()
        || (
          resource.data.active == true
          && resource.data.schemaVersion == 1
        );
      allow create, update, delete: if isSuperAdmin();
    }

    match /marketplaceRestaurantCategoryOffers/{offerId} {
      allow read: if resource.data.discoverable == true
        && resource.data.schemaVersion == 1;

      allow create: if canManageRestaurantMenu(request.resource.data.restaurantId)
        && request.resource.data.restaurantId is string
        && request.resource.data.marketplaceCategoryId is string
        && request.resource.data.discoverable is bool
        && request.resource.data.schemaVersion == 1;

      allow update: if canManageRestaurantMenu(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.restaurantId is string
        && request.resource.data.marketplaceCategoryId is string
        && request.resource.data.discoverable is bool
        && request.resource.data.schemaVersion == 1;

      allow delete: if canManageRestaurantMenu(resource.data.restaurantId);
    }

    match /{path=**}/orderItems/{itemId} {
      allow list: if resource.data.restaurantId is string
        && request.query.limit != null
        && request.query.limit <= 500
        && (
          (
            (
              userExists()
              && userDoc().data.restaurantId == resource.data.restaurantId
              && userDoc().data.role in ["cashier", "manager", "owner"]
            )
            || (
              isRestaurantStaff(resource.data.restaurantId)
              && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)/staff/$(request.auth.uid)).data.role in ["cashier", "manager", "owner"]
            )
          )
          ||
          (
            (
              (
                userExists()
                && userDoc().data.restaurantId == resource.data.restaurantId
                && userDoc().data.role == "kitchen"
              )
              || (
                isRestaurantStaff(resource.data.restaurantId)
                && get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)/staff/$(request.auth.uid)).data.role == "kitchen"
              )
            )
            && resource.data.preparationMode == "kitchen"
            && resource.data.status in ["pending", "preparing", "ready"]
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
