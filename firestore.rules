rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Autoriser la lecture publique de la configuration plateforme (Branding)
    match /platform/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Autoriser tout le monde à envoyer une demande de contact
    match /contactRequests/{document=**} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Par défaut, lecture/écriture autorisée pour tout utilisateur authentifié
    // Utile pour la phase de développement SaaS
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}