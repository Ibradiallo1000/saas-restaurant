
{
  "entities": {
    "PlatformConfig": {
      "title": "PlatformConfig",
      "type": "object",
      "description": "Configuration globale de la plateforme SaaS.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "supportEmail": { "type": "string", "format": "email" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PlatformUser": {
      "title": "PlatformUser",
      "type": "object",
      "description": "Administrateur de la plateforme SaaS.",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin"] },
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Restaurant": {
      "title": "Restaurant",
      "type": "object",
      "description": "Données d'un établissement client.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Plan": {
      "title": "Plan",
      "type": "object",
      "description": "Définition des offres d'abonnement.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "features": {
          "type": "object",
          "properties": {
            "maxUsers": { "type": "number" },
            "aiEnabled": { "type": "boolean" },
            "advancedReports": { "type": "boolean" },
            "multiBranch": { "type": "boolean" }
          }
        }
      }
    },
    "Subscription": {
      "title": "Subscription",
      "type": "object",
      "description": "Suivi de l'abonnement d'un restaurant.",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "planId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "suspended"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "isTrial": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "structure": [
      { "path": "platform/{platformId}", "definition": { "schema": { "$ref": "#/backend/entities/PlatformConfig" }, "description": "Config globale." } },
      { "path": "platformUsers/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/PlatformUser" }, "description": "Admins SaaS." } },
      { "path": "restaurants/{restaurantId}", "definition": { "schema": { "$ref": "#/backend/entities/Restaurant" }, "description": "Données établissements." } },
      { "path": "plans/{planId}", "definition": { "schema": { "$ref": "#/backend/entities/Plan" }, "description": "Offres SaaS." } },
      { "path": "subscriptions/{subId}", "definition": { "schema": { "$ref": "#/backend/entities/Subscription" }, "description": "Abonnements actifs." } }
    ]
  }
}
