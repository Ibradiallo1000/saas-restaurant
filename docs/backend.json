{
  "entities": {
    "Plan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Plan",
      "type": "object",
      "description": "Represents a subscription plan offered by the SaaS, defining features and limits for restaurants.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "priceMonthly": { "type": "number" },
        "maxStaff": { "type": "number" },
        "maxMenus": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "priceMonthly", "features", "createdAt"]
    },
    "Restaurant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Restaurant",
      "type": "object",
      "description": "Represents a restaurant or hotel establishment using the SaaS platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "planId": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "trialStartDate": { "type": "string", "format": "date-time" },
        "trialEndDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "country", "currency", "planId", "active", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the SaaS platform.",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "name", "email", "active", "createdAt"]
    },
    "CashierSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CashierSession",
      "type": "object",
      "description": "Tracks a cashier's working shift and sales totals.",
      "properties": {
        "id": { "type": "string" },
        "cashierId": { "type": "string" },
        "restaurantId": { "type": "string" },
        "openedAt": { "type": "string", "format": "date-time" },
        "closedAt": { "type": "string", "format": "date-time" },
        "totalCash": { "type": "number" },
        "totalMobileMoney": { "type": "number" },
        "totalSales": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] }
      },
      "required": ["cashierId", "restaurantId", "openedAt", "status"]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "totalAmount": { "type": "number" },
        "customerName": { "type": "string" },
        "tableId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "restaurantId", "type", "status", "paymentStatus", "totalAmount", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "plans/{planId}", "definition": { "entityName": "plan", "schema": { "$ref": "#/backend/entities/Plan" }, "description": "Global subscription plans." } },
      { "path": "restaurants/{restaurantId}", "definition": { "entityName": "restaurant", "schema": { "$ref": "#/backend/entities/Restaurant" }, "description": "Tenants collection." } },
      { "path": "users/{userId}", "definition": { "entityName": "user", "schema": { "$ref": "#/backend/entities/User" }, "description": "User profiles." } },
      { "path": "orders/{orderId}", "definition": { "entityName": "order", "schema": { "$ref": "#/backend/entities/Order" }, "description": "Global orders collection." } },
      { "path": "cashierSessions/{sessionId}", "definition": { "entityName": "cashierSession", "schema": { "$ref": "#/backend/entities/CashierSession" }, "description": "Cashier shift tracking." } }
    ],
    "reasoning": "Standard root-level multi-tenant structure using restaurantId for isolation and efficient querying."
  }
}