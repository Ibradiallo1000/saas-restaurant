
{
  "entities": {
    "PlatformConfig": {
      "title": "PlatformConfig",
      "type": "object",
      "description": "Configuration globale de la plateforme SaaS.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "subscriptionModel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PlatformUser": {
      "title": "PlatformUser",
      "type": "object",
      "description": "Administrateur de la plateforme SaaS (Super Admin).",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin"] },
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Restaurant": {
      "title": "Restaurant",
      "type": "object",
      "description": "Représente un établissement (restaurant/hôtel) lié à un propriétaire.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string", "description": "ID de l'utilisateur Propriétaire (Owner)." },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "planId": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "suspended"] },
        "subscriptionStartDate": { "type": "string", "format": "date-time" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Profil utilisateur local à un restaurant.",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "manager", "accountant", "cashier", "kitchen", "server"] },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "structure": [
      { "path": "platform/{platformId}", "definition": { "schema": { "$ref": "#/backend/entities/PlatformConfig" }, "description": "Configuration de la plateforme." } },
      { "path": "platformUsers/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/PlatformUser" }, "description": "Admins de la plateforme." } },
      { "path": "restaurants/{restaurantId}", "definition": { "schema": { "$ref": "#/backend/entities/Restaurant" }, "description": "Données de l'établissement." } },
      { "path": "users/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/UserProfile" }, "description": "Utilisateurs locaux." } }
    ]
  }
}
