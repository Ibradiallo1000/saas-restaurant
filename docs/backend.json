{
  "entities": {
    "Restaurant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Restaurant",
      "type": "object",
      "description": "Représente un établissement (restaurant/hôtel) lié à un propriétaire.",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string", "description": "ID de l'utilisateur Propriétaire (Owner)." },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "country": { "type": "string" },
        "currency": { "type": "string" },
        "planId": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "suspended"] },
        "subscriptionStartDate": { "type": "string", "format": "date-time" },
        "subscriptionEndDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "slug", "country", "currency", "planId", "subscriptionStatus", "createdAt"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Profil utilisateur avec rôle et lien vers un restaurant spécifique (sauf Owner).",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string", "description": "ID du restaurant assigné. Optionnel pour l'Owner multi-sites." },
        "role": { "type": "string", "enum": ["super_admin", "owner", "manager", "accountant", "cashier", "kitchen", "server"] },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "email", "active", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "type": "object",
      "description": "Historique de facturation manuelle pour l'abonnement SaaS.",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "structure": [
      { "path": "restaurants/{restaurantId}", "definition": { "schema": { "$ref": "#/backend/entities/Restaurant" }, "description": "Données de l'établissement et état de l'abonnement." } },
      { "path": "users/{userId}", "definition": { "schema": { "$ref": "#/backend/entities/UserProfile" }, "description": "Utilisateurs avec rôles spécifiques." } },
      { "path": "restaurants/{restaurantId}/invoices/{invoiceId}", "definition": { "schema": { "$ref": "#/backend/entities/Invoice" }, "description": "Historique des factures de l'établissement." } }
    ]
  }
}