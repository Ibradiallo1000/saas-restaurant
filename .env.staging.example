# Safe placeholders only. Real staging values belong in the Netlify environment manager.
APP_ENV=staging

NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-staging-public-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-staging-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-staging-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-staging-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-staging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-staging-app-id

FIREBASE_PROJECT_ID=replace-with-staging-project-id
FIREBASE_CLIENT_EMAIL=replace-with-staging-service-account-email
FIREBASE_PRIVATE_KEY=replace-in-netlify-only

NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-with-staging-recaptcha-site-key
ORDER_QR_CAPABILITY_SECRET=replace-in-netlify-with-a-staging-only-secret

NEXT_PUBLIC_QR_CANONICAL_MODE=canonical
NEXT_PUBLIC_QR_CANONICAL_RESTAURANTS=replace-with-staging-pilot-restaurant-id
NEXT_PUBLIC_POS_CANONICAL_MODE=canonical
NEXT_PUBLIC_POS_CANONICAL_RESTAURANTS=replace-with-staging-pilot-restaurant-id
NEXT_PUBLIC_KITCHEN_CANONICAL_READ_MODE=canonical
NEXT_PUBLIC_KITCHEN_CANONICAL_READ_RESTAURANTS=replace-with-staging-pilot-restaurant-id

# Required by the local deployment guard; never set this in production.
OORDERA_STAGING_SECRETS_DISTINCT=YES
