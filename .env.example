# Safe placeholders only. Never commit real credentials or secrets.
APP_ENV=development

# Firebase client
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-app-id

# Local emulators only. Keep disabled outside a demo-* project.
NEXT_PUBLIC_FIREBASE_EMULATORS=0
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8282
NEXT_PUBLIC_ORDER_E2E_APP_CHECK_TOKEN=replace-with-local-proof-at-least-32-characters

# Firebase Admin
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY=replace-in-environment-manager-only

# Public-order security
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=replace-with-recaptcha-site-key
ORDER_QR_CAPABILITY_SECRET=replace-in-environment-manager-with-at-least-32-random-characters

# Canonical engines
NEXT_PUBLIC_QR_CANONICAL_MODE=legacy
NEXT_PUBLIC_QR_CANONICAL_RESTAURANTS=
NEXT_PUBLIC_POS_CANONICAL_MODE=legacy
NEXT_PUBLIC_POS_CANONICAL_RESTAURANTS=
NEXT_PUBLIC_KITCHEN_CANONICAL_READ_MODE=legacy
NEXT_PUBLIC_KITCHEN_CANONICAL_READ_RESTAURANTS=
