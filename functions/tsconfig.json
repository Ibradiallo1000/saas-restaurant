{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "..",
    "outDir": "lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/marketplace-discovery/**/*.ts"
  ]
}
